/-- Every word is below `2^64`. -/
def Bounded (s : DivstepState) : Prop :=
   s.two_delta < 2^64 ∧ s.f < 2^64 ∧ s.g < 2^64 ∧ s.t < 2^64 ∧ s.z < 2^64

end DivstepState

/-- `divstep!()`, one packed half-delta divstep: it finishes the step that the previous arm started,
adding `t` to the packed `g`, halving it, and adding two to `two_delta`, and starts the next from
the sign of the new `two_delta` and the parity of the new `g` -/
def divstepRound (st : DivstepState) : DivstepState :=
  let td := st.two_delta         -- argument
  let pf := st.f                 -- argument
  let pg := st.g                 -- argument
  let t := st.t                  -- argument
  let z := st.z                  -- argument
  let k := 18446744073709551614  -- mov {k}, -2
  let s := addc td 2 0           -- add {td}, 2
  let td := s.1                  --   `-> td
  let cf := s.2                  --   `-> cf
  let pg := addw pg t            -- lea {pg}, [{pg} + {t}]
  let k := cmovs td k z          -- cmovs {k}, {z}
