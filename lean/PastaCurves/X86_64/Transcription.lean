  let k := cmovz zs k z          -- cmove {k}, {z}
  let t := cmovz zs t z          -- cmove {t}, {z}
  let pg := asr pg 1             -- sar {pg}, 1
  let t := eorw t k              -- xor {t}, {k}
  let td := eorw td k            -- xor {td}, {k}
  let cf := bt k 63              -- bt {k}, 63
  let pf := cmovb cf pf pg       -- cmovb {pf}, {pg}
