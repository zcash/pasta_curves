  ⟨u, v, q, r, su, sv, sq, sr⟩

/-- The inline `asm!` block of `fg_row`: one row of the update of `f` and `g`, `(m0 f + m1 g) /
2^59` on five-word signed values, from the row's magnitudes `m0`, `m1` and sign masks `s0`, `s1`, as
a 320-bit accumulation shifted right by 59. -/
def fgRowBlock (f g : Signed5) (m0 m1 s0 s1 : Nat) : Signed5 :=
  let m0 := m0             -- scalar input
  let m1 := m1             -- scalar input
  let s0 := s0             -- scalar input
  let s1 := s1             -- scalar input
  let t0 := m0             -- mov {t0}, {m0}
  let t0 := andw t0 s0     -- and {t0}, {s0}
  let rax := m1            -- mov rax, {m1}
  let rax := andw rax s1   -- and rax, {s1}
  let s := addc t0 rax 0   -- add {t0}, rax
  let t0 := s.1            --   `-> t0
  let cf := s.2            --   `-> cf
  let t1 := 0              -- xor {t1:e}, {t1:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let t2 := 0              -- xor {t2:e}, {t2:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let t3 := 0              -- xor {t3:e}, {t3:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let t4 := 0              -- xor {t4:e}, {t4:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let rax := f.l0          -- mov rax, qword ptr [{x}]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t0 rax 0   -- add {t0}, rax
  let t0 := s.1            --   `-> t0
  let cf := s.2            --   `-> cf
  let s := addc t1 rdx cf  -- adc {t1}, rdx
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let rax := g.l0          -- mov rax, qword ptr [{y}]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t0 rax 0   -- add {t0}, rax
  let t0 := s.1            --   `-> t0
  let cf := s.2            --   `-> cf
  let s := addc t1 rdx cf  -- adc {t1}, rdx
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let rax := f.l1          -- mov rax, qword ptr [{x} + 8]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t1 rax 0   -- add {t1}, rax
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let s := addc t2 rdx cf  -- adc {t2}, rdx
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let rax := g.l1          -- mov rax, qword ptr [{y} + 8]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t1 rax 0   -- add {t1}, rax
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let s := addc t2 rdx cf  -- adc {t2}, rdx
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let rax := f.l2          -- mov rax, qword ptr [{x} + 16]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t2 rax 0   -- add {t2}, rax
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let s := addc t3 rdx cf  -- adc {t3}, rdx
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let rax := g.l2          -- mov rax, qword ptr [{y} + 16]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t2 rax 0   -- add {t2}, rax
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let s := addc t3 rdx cf  -- adc {t3}, rdx
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let rax := f.l3          -- mov rax, qword ptr [{x} + 24]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t3 rax 0   -- add {t3}, rax
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let s := addc t4 rdx cf  -- adc {t4}, rdx
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  let rax := g.l3          -- mov rax, qword ptr [{y} + 24]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t3 rax 0   -- add {t3}, rax
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let s := addc t4 rdx cf  -- adc {t4}, rdx
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  let rax := f.l4          -- mov rax, qword ptr [{x} + 32]
  let rax := eorw rax s0   -- xor rax, {s0}
  let rax := mulLo rax m0  -- imul rax, {m0}
  let s := addc t4 rax 0   -- add {t4}, rax
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  let rax := g.l4          -- mov rax, qword ptr [{y} + 32]
  let rax := eorw rax s1   -- xor rax, {s1}
  let rax := mulLo rax m1  -- imul rax, {m1}
  let s := addc t4 rax 0   -- add {t4}, rax
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  let t0 := extr t1 t0 59  -- shrd {t0}, {t1}, 59
  let t1 := extr t2 t1 59  -- shrd {t1}, {t2}, 59
  let t2 := extr t3 t2 59  -- shrd {t2}, {t3}, 59
  let t3 := extr t4 t3 59  -- shrd {t3}, {t4}, 59
  let t4 := asr t4 59      -- sar {t4}, 59
  ⟨t0, t1, t2, t3, t4⟩

/-- The inline `asm!` block of `de_row`: one row of the combination of `d` and `e`, `m0 d + m1 e` as
a five-word signed value, from the row's magnitudes `m0`, `m1` and sign masks `s0`, `s1`. It is the
accumulation of `fgRowBlock` without the shift. -/
def deRowBlock (d e : Limbs) (m0 m1 s0 s1 : Nat) : Signed5 :=
  let m0 := m0             -- scalar input
  let m1 := m1             -- scalar input
  let s0 := s0             -- scalar input
  let s1 := s1             -- scalar input
  let t0 := m0             -- mov {t0}, {m0}
  let t0 := andw t0 s0     -- and {t0}, {s0}
  let rax := m1            -- mov rax, {m1}
  let rax := andw rax s1   -- and rax, {s1}
  let s := addc t0 rax 0   -- add {t0}, rax
  let t0 := s.1            --   `-> t0
  let cf := s.2            --   `-> cf
  let t1 := 0              -- xor {t1:e}, {t1:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let t2 := 0              -- xor {t2:e}, {t2:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let t3 := 0              -- xor {t3:e}, {t3:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let t4 := 0              -- xor {t4:e}, {t4:e}
  let cf := 0              --   `-> cf
  let ofl := 0             --   `-> ofl
  let rax := d.l0          -- mov rax, qword ptr [{x}]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t0 rax 0   -- add {t0}, rax
  let t0 := s.1            --   `-> t0
  let cf := s.2            --   `-> cf
  let s := addc t1 rdx cf  -- adc {t1}, rdx
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let rax := e.l0          -- mov rax, qword ptr [{y}]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t0 rax 0   -- add {t0}, rax
  let t0 := s.1            --   `-> t0
  let cf := s.2            --   `-> cf
  let s := addc t1 rdx cf  -- adc {t1}, rdx
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let rax := d.l1          -- mov rax, qword ptr [{x} + 8]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t1 rax 0   -- add {t1}, rax
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let s := addc t2 rdx cf  -- adc {t2}, rdx
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let rax := e.l1          -- mov rax, qword ptr [{y} + 8]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t1 rax 0   -- add {t1}, rax
  let t1 := s.1            --   `-> t1
  let cf := s.2            --   `-> cf
  let s := addc t2 rdx cf  -- adc {t2}, rdx
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let rax := d.l2          -- mov rax, qword ptr [{x} + 16]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t2 rax 0   -- add {t2}, rax
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let s := addc t3 rdx cf  -- adc {t3}, rdx
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let rax := e.l2          -- mov rax, qword ptr [{y} + 16]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t2 rax 0   -- add {t2}, rax
  let t2 := s.1            --   `-> t2
  let cf := s.2            --   `-> cf
  let s := addc t3 rdx cf  -- adc {t3}, rdx
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let rax := d.l3          -- mov rax, qword ptr [{x} + 24]
  let rax := eorw rax s0   -- xor rax, {s0}
  let m := mulq rax m0     -- mul {m0}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t3 rax 0   -- add {t3}, rax
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let s := addc t4 rdx cf  -- adc {t4}, rdx
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  let rax := e.l3          -- mov rax, qword ptr [{y} + 24]
  let rax := eorw rax s1   -- xor rax, {s1}
  let m := mulq rax m1     -- mul {m1}
  let rax := m.1           --   `-> rax
  let rdx := m.2           --   `-> rdx
  let s := addc t3 rax 0   -- add {t3}, rax
  let t3 := s.1            --   `-> t3
  let cf := s.2            --   `-> cf
  let s := addc t4 rdx cf  -- adc {t4}, rdx
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  let rax := s0            -- mov rax, {s0}
  let rax := mulLo rax m0  -- imul rax, {m0}
  let s := addc t4 rax 0   -- add {t4}, rax
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  let rax := s1            -- mov rax, {s1}
  let rax := mulLo rax m1  -- imul rax, {m1}
  let s := addc t4 rax 0   -- add {t4}, rax
  let t4 := s.1            --   `-> t4
  let cf := s.2            --   `-> cf
  ⟨t0, t1, t2, t3, t4⟩

/-- The inline `asm!` block of `amontred`: the almost-Montgomery reduction of a five-word signed
value by one word, `(s + w p) / 2^64` for `s = t + 2^61 p` and `w = s inv mod 2^64`, as four words.
For the Pasta shape no top carry is captured and no conditional subtraction follows. -/
def amontredBlock (t : Signed5) (modulus : Limbs) (inv : Nat) : Limbs :=
  let t0 := t.l0                -- input t[0]
  let t1 := t.l1                -- input t[1]
  let t2 := t.l2                -- input t[2]
  let t3 := t.l3                -- input t[3]
  let t4 := t.l4                -- input t[4]
  let inv := inv                -- scalar input
  let w0 := modulus.l0          -- mov {w0}, qword ptr [{p}]
  let w0 := lsl w0 61           -- shl {w0}, 61
  let w2 := modulus.l1          -- mov {w2}, qword ptr [{p} + 8]
  let w1 := modulus.l0          -- mov {w1}, qword ptr [{p}]
  let w1 := extr w2 w1 3        -- shrd {w1}, {w2}, 3
  let w2 := lsr w2 3            -- shr {w2}, 3
  let w3 := 576460752303423488  -- movabs {w3}, 0x800000000000000
  let s := addc t0 w0 0         -- add {t0}, {w0}
  let t0 := s.1                 --   `-> t0
  let cf := s.2                 --   `-> cf
  let s := addc t1 w1 cf        -- adc {t1}, {w1}
  let t1 := s.1                 --   `-> t1
  let cf := s.2                 --   `-> cf
  let s := addc t2 w2 cf        -- adc {t2}, {w2}
  let t2 := s.1                 --   `-> t2
  let cf := s.2                 --   `-> cf
  let s := addc t3 0 cf         -- adc {t3}, 0
  let t3 := s.1                 --   `-> t3
  let cf := s.2                 --   `-> cf
  let s := addc t4 w3 cf        -- adc {t4}, {w3}
  let t4 := s.1                 --   `-> t4
  let cf := s.2                 --   `-> cf
  let rdx := t0                 -- mov rdx, {t0}
  let rdx := mulLo rdx inv      -- imul rdx, {inv}
  let m := mulx rdx modulus.l0  -- mulx {w0}, {w1}, qword ptr [{p}]
  let w0 := m.1                 --   `-> w0
  let w1 := m.2                 --   `-> w1
  let m := mulx rdx modulus.l1  -- mulx {w2}, {w3}, qword ptr [{p} + 8]
  let w2 := m.1                 --   `-> w2
  let w3 := m.2                 --   `-> w3
  let w1 := rdx                 -- mov {w1}, rdx
  let w1 := lsl w1 62           -- shl {w1}, 62
  let w4 := rdx                 -- mov {w4}, rdx
  let w4 := lsr w4 2            -- shr {w4}, 2
  let n := neg t0               -- neg {t0}
  let t0 := n.1                 --   `-> t0
  let cf := n.2                 --   `-> cf
  let s := addc t1 w0 cf        -- adc {t1}, {w0}
  let t1 := s.1                 --   `-> t1
  let cf := s.2                 --   `-> cf
  let s := addc t2 w2 cf        -- adc {t2}, {w2}
  let t2 := s.1                 --   `-> t2
  let cf := s.2                 --   `-> cf
  let s := addc t3 w1 cf        -- adc {t3}, {w1}
  let t3 := s.1                 --   `-> t3
  let cf := s.2                 --   `-> cf
  let s := addc t4 w4 cf        -- adc {t4}, {w4}
  let t4 := s.1                 --   `-> t4
  let cf := s.2                 --   `-> cf
  let s := addc t1 w3 0         -- add {t1}, {w3}
  let t1 := s.1                 --   `-> t1
  let cf := s.2                 --   `-> cf
  let s := addc t2 0 cf         -- adc {t2}, 0
  let t2 := s.1                 --   `-> t2
  let cf := s.2                 --   `-> cf
  let s := addc t3 0 cf         -- adc {t3}, 0
  let t3 := s.1                 --   `-> t3
  let cf := s.2                 --   `-> cf
  let s := addc t4 0 cf         -- adc {t4}, 0
  let t4 := s.1                 --   `-> t4
  let cf := s.2                 --   `-> cf
  ⟨t1, t2, t3, t4⟩

/-- The inline `asm!` block of `cond_sub`: the subtraction of the modulus from `value`, kept unless
it borrows. For `value < 2p` the result is `value mod p`. -/
def condSubBlock (value modulus : Limbs) : Limbs :=
  let r0 := value.l0         -- input r0
  let r1 := value.l1         -- input r1
  let r2 := value.l2         -- input r2
  let r3 := value.l3         -- input r3
  let p0 := modulus.l0       -- input modulus[0]
  let p1 := modulus.l1       -- input modulus[1]
  let p3 := modulus.l3       -- input modulus[3]
  let t0 := r0               -- mov {t0}, {r0}
  let d := sbb t0 p0 0       -- sub {t0}, {p0}
  let t0 := d.1              --   `-> t0
  let cf := d.2              --   `-> cf
  let t1 := r1               -- mov {t1}, {r1}
  let d := sbb t1 p1 cf      -- sbb {t1}, {p1}
  let t1 := d.1              --   `-> t1
  let cf := d.2              --   `-> cf
  let t2 := r2               -- mov {t2}, {r2}
  let d := sbb t2 0 cf       -- sbb {t2}, 0
  let t2 := d.1              --   `-> t2
  let cf := d.2              --   `-> cf
  let t3 := r3               -- mov {t3}, {r3}
  let d := sbb t3 p3 cf      -- sbb {t3}, {p3}
  let t3 := d.1              --   `-> t3
  let cf := d.2              --   `-> cf
  let r0 := cmovnc cf r0 t0  -- cmovnc {r0}, {t0}
  let r1 := cmovnc cf r1 t1  -- cmovnc {r1}, {t1}
  let r2 := cmovnc cf r2 t2  -- cmovnc {r2}, {t2}
  let r3 := cmovnc cf r3 t3  -- cmovnc {r3}, {t3}
  ⟨r0, r1, r2, r3⟩

end PastaCurves.X86_64
