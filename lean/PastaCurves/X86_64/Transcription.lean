  two_delta : Nat
  /-- the packed `f` word -/
  f : Nat
  /-- the packed `g` word -/
  g : Nat
  /-- the term that the step adds to `g`: `f`, `-f`, or zero -/
  t : Nat
  /-- zero, which the conditional moves take -/
  z : Nat
