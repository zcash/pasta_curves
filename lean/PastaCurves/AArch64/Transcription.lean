  v : Nat
  q : Nat
  r : Nat
  su : Nat
  sv : Nat
  sq : Nat
  sr : Nat
  deriving DecidableEq, Repr

/-- The inline `asm!` block of `sign_mag`: the sign-magnitude form of the four entries of a
transition matrix, each entry's magnitude and its sign as a mask (all ones when negative, else
zero), which the row blocks take. -/
def signMagBlock (u v q r : Nat) : SignMag :=
  let u := u                    -- argument
  let v := v                    -- argument
  let q := q                    -- argument
  let r := r                    -- argument
  let fl := cmpFlags u 0        -- cmp u,xzr
  let su := csetmMi fl          -- csetm su,mi
  let u := cnegMi fl u          -- cneg u,u,mi
  let fl := cmpFlags v 0        -- cmp v,xzr
  let sv := csetmMi fl          -- csetm sv,mi
  let v := cnegMi fl v          -- cneg v,v,mi
  let fl := cmpFlags q 0        -- cmp q,xzr
  let sq := csetmMi fl          -- csetm sq,mi
  let q := cnegMi fl q          -- cneg q,q,mi
  let fl := cmpFlags r 0        -- cmp r,xzr
  let sr := csetmMi fl          -- csetm sr,mi
  let r := cnegMi fl r          -- cneg r,r,mi
  ⟨u, v, q, r, su, sv, sq, sr⟩

