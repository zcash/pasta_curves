/-- The inline `asm!` block of `add`: modular addition, `lhs + rhs mod p`, as a full-width addition,
a subtraction of the modulus, and the selection of the reduced sum when that subtraction did not
borrow, with the result in the block's `inout` operands. -/
def addMod (lhs rhs modulus : Limbs) : Limbs :=
  let r0 := lhs.l0              -- argument
  let r1 := lhs.l1              -- argument
  let r2 := lhs.l2              -- argument
  let r3 := lhs.l3              -- argument
  let b0 := rhs.l0              -- argument
  let b1 := rhs.l1              -- argument
  let b2 := rhs.l2              -- argument
  let b3 := rhs.l3              -- argument
  let p0 := modulus.l0          -- argument
  let p1 := modulus.l1          -- argument
  let p3 := modulus.l3          -- argument
  let s := addc r0 b0 0         -- adds r0,r0,b0
  let r0 := s.1                 --   `-> r0
  let c := s.2                  --   `-> carry
  let s := addc r1 b1 c         -- adcs r1,r1,b1
  let r1 := s.1                 --   `-> r1
  let c := s.2                  --   `-> carry
  let s := addc r2 b2 c         -- adcs r2,r2,b2
  let r2 := s.1                 --   `-> r2
  let c := s.2                  --   `-> carry
  let r3 := (addc r3 b3 c).1    -- adc r3,r3,b3
  let s := subc r0 p0 1         -- subs t0,r0,p0
  let t0 := s.1                 --   `-> t0
  let c := s.2                  --   `-> carry
  let s := subc r1 p1 c         -- sbcs t1,r1,p1
  let t1 := s.1                 --   `-> t1
  let c := s.2                  --   `-> carry
  let s := subc r2 0 c          -- sbcs t2,r2,xzr
  let t2 := s.1                 --   `-> t2
  let c := s.2                  --   `-> carry
  let s := subc r3 p3 c         -- sbcs t3,r3,p3
  let t3 := s.1                 --   `-> t3
  let c := s.2                  --   `-> carry
  let r0 := cselCs c t0 r0      -- csel r0,t0,r0,cs
  let r1 := cselCs c t1 r1      -- csel r1,t1,r1,cs
  let r2 := cselCs c t2 r2      -- csel r2,t2,r2,cs
  let r3 := cselCs c t3 r3      -- csel r3,t3,r3,cs
  ⟨r0, r1, r2, r3⟩

/-- The inline `asm!` block of `sub`: modular subtraction, `lhs - rhs mod p`, as a full-width
subtraction and the addition of the modulus when it borrowed, with the result in the block's `inout`
operands. -/
def subMod (lhs rhs modulus : Limbs) : Limbs :=
  let r0 := lhs.l0              -- argument
  let r1 := lhs.l1              -- argument
  let r2 := lhs.l2              -- argument
  let r3 := lhs.l3              -- argument
  let b0 := rhs.l0              -- argument
  let b1 := rhs.l1              -- argument
  let b2 := rhs.l2              -- argument
  let b3 := rhs.l3              -- argument
  let p0 := modulus.l0          -- argument
  let p1 := modulus.l1          -- argument
  let p3 := modulus.l3          -- argument
  let s := subc r0 b0 1         -- subs r0,r0,b0
  let r0 := s.1                 --   `-> r0
  let c := s.2                  --   `-> carry
  let s := subc r1 b1 c         -- sbcs r1,r1,b1
  let r1 := s.1                 --   `-> r1
  let c := s.2                  --   `-> carry
  let s := subc r2 b2 c         -- sbcs r2,r2,b2
  let r2 := s.1                 --   `-> r2
  let c := s.2                  --   `-> carry
  let s := subc r3 b3 c         -- sbcs r3,r3,b3
  let r3 := s.1                 --   `-> r3
  let c := s.2                  --   `-> carry
  let t0 := cselLo c p0 0       -- csel t0,p0,xzr,cc
  let t1 := cselLo c p1 0       -- csel t1,p1,xzr,cc
  let t3 := cselLo c p3 0       -- csel t3,p3,xzr,cc
  let s := addc r0 t0 0         -- adds r0,r0,t0
  let r0 := s.1                 --   `-> r0
  let c := s.2                  --   `-> carry
  let s := addc r1 t1 c         -- adcs r1,r1,t1
  let r1 := s.1                 --   `-> r1
  let c := s.2                  --   `-> carry
  let s := addc r2 0 c          -- adcs r2,r2,xzr
  let r2 := s.1                 --   `-> r2
  let c := s.2                  --   `-> carry
  let r3 := (addc r3 t3 c).1    -- adc r3,r3,t3
  ⟨r0, r1, r2, r3⟩

/-- The registers that `divstepRound` carries in and out. -/
structure DivstepState where
  /-- `two_delta = 2δ`, as a two's-complement word -/
  two_delta : Nat
  /-- the packed `f` word -/
  f : Nat
  /-- the packed `g` word -/
  g : Nat
  /-- the flags, set by the parity test of the packed `g` word -/
  fl : Flags
  deriving DecidableEq, Repr

namespace DivstepState

/-- Every word is below `2^64`. -/
def Bounded (s : DivstepState) : Prop :=
   s.two_delta < 2^64 ∧ s.f < 2^64 ∧ s.g < 2^64

end DivstepState

/-- `divstep!()`, one packed half-delta divstep on the words `f` and `g` at `two_delta`, from the
flags of the parity test of `g`, ending with the parity test of the new `g` for the next step -/
def divstepRound (st : DivstepState) : DivstepState :=
  let two_delta := st.two_delta  -- argument
  let pf := st.f                -- argument
  let pg := st.g                -- argument
  let fl := st.fl               -- argument
  let t := cselNe fl pf 0       -- csel t,pf,xzr,ne
  let fl := ccmpNe fl two_delta 0 8  -- ccmp two_delta,xzr,#8,ne
  let two_delta := cnegGe fl two_delta  -- cneg two_delta,two_delta,ge
  let t := cnegGe fl t          -- cneg t,t,ge
  let pf := cselGe fl pg pf     -- csel pf,pg,pf,ge
  let pg := addw pg t           -- add pg,pg,t
  let two_delta := addw two_delta 2  -- add two_delta,two_delta,#2
  let fl := tstFlags (andw pg 2)  -- tst pg,#2
  let pg := asr pg 1            -- asr pg,pg,#1
  ⟨two_delta, pf, pg, fl⟩

/-- `divstep!(last)`, the last divstep of a batch: `divstepRound` without the parity test at its end
-/
def divstepLast (st : DivstepState) : DivstepState :=
  let two_delta := st.two_delta  -- argument
  let pf := st.f                -- argument
  let pg := st.g                -- argument
  let fl := st.fl               -- argument
  let t := cselNe fl pf 0       -- csel t,pf,xzr,ne
  let fl := ccmpNe fl two_delta 0 8  -- ccmp two_delta,xzr,#8,ne
  let two_delta := cnegGe fl two_delta  -- cneg two_delta,two_delta,ge
  let t := cnegGe fl t          -- cneg t,t,ge
  let pf := cselGe fl pg pf     -- csel pf,pg,pf,ge
  let pg := addw pg t           -- add pg,pg,t
  let two_delta := addw two_delta 2  -- add two_delta,two_delta,#2
  let pg := asr pg 1            -- asr pg,pg,#1
  ⟨two_delta, pf, pg, fl⟩

