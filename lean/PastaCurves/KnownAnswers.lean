-- `FP.two_r`: `2R mod p`.
example : let p := pallasBase.modulus.toNat
    let x := Limbs.toNat
      ⟨0xcfc3a984fffffff9, 0x1011d11bbee5303e, 0xffffffffffffffff, 0x3fffffffffffffff⟩
    x = (2*R) % p := by
  decide +kernel

