/-- The Pallas base field's modulus is prime. -/
theorem pallasBase_prime :
    Nat.Prime 0x40000000000000000000000000000000224698fc094cf91b992d30ed00000001 :=
  prime_of_check (bits := 256) (es := pallasBaseCertificate) (by decide +kernel) (by decide +kernel)

/-- The Vesta base field's modulus is prime. -/
theorem vestaBase_prime :
    Nat.Prime 0x40000000000000000000000000000000224698fc0994a8dd8c46eb2100000001 :=
  prime_of_check (bits := 256) (es := vestaBaseCertificate) (by decide +kernel) (by decide +kernel)

