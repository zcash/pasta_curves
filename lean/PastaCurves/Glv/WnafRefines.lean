import PastaCurves.Glv.Funs
import PastaCurves.Glv.Wnaf

/-!
# Aeneas' translation of `wnaf_digits` refines the model

`Funs.lean` is Aeneas' translation of `wnaf_digits` (`src/glv.rs`), generated by
`lean/scripts/gen_aeneas.sh`. The translation has the semantics of a debug build: the
`debug_assert!` becomes `massert`, and every `-`, `+`, negation, the write `digits[n] = …` and
`n += 1` is checked, so it fails at the first operation that would panic. The model
(`Model.lean`) instead runs to the end, wrapping as a release build does and recording each check
in a flag (`Wnaf.State.panicsIn`).

`wnaf_digits_refines` says that the two agree exactly: where the model says a debug build panics,
the translation fails, at the assertion; elsewhere it returns the model's `(digits, n)`.
`wnaf_digits_refines_ofResult` is the same with the outcome read as an `Option` (which would not
tell a failure from a divergence), and `wnaf_digits_refines_of_lt` is the form below `2^127`. So
below `2^127` the translation returns `Wnaf.run`, whose digits have the shape and value of
`wnaf_digits_shape` and `wnaf_digits_value` and number at most 128
(`wnaf_digits_length_le_128`), and from `2^127` on it fails at the assertion
(`wnaf_digits_checks`). What `Wnaf.lean`'s remarks say about builds that lack debug assertions or
overflow checks concerns the model alone: in the translation only the assertion can fail.

Below `2^127` the model sets no flag (`wnaf_digits_no_panic`), so the translation's checks inside
the loop never fire there, and the loop needs only a success argument; the model's `n` ends at
most at 128, so `n += 1` stays far from `usize::MAX`. From `2^127` on, the translation
fails at its first statement, the `debug_assert!`, and the model's assertion flag is set. The
loop is related to the model pass by pass: `LoopRel` reads the translation's state
`(digits, n, k)` as a model state, flags aside; one run of the body is one `Wnaf.step`
(`body_step`), and an induction on the model's fuel, unfolding Aeneas' `loop` once per pass,
gives the whole loop (`loop_ok`).
-/

namespace PastaCurves.Glv

/-! ## The model's loop -/

namespace Wnaf

/-- Each pass adds one to `n`, so the loop never lowers it. -/
private theorem loop_n_le (neg : Bool) : ∀ (fuel : ℕ) (s : State), s.n ≤ (loop neg fuel s).n := by
  intro fuel
  induction fuel with
  | zero => intro s; simp [Wnaf.loop]
  | succ f ih =>
    intro s
    simp only [Wnaf.loop]
    split
    · exact le_rfl
    · have h := ih (Wnaf.step neg s)
      rw [step_n] at h
      omega

/-- A pass keeps every flag that is set, so a state from which the loop ends with no flag set has
none set itself. -/
private theorem loop_clear (neg : Bool) : ∀ (fuel : ℕ) (s : State),
    (loop neg fuel s).panicsIn true true = false → s.panicsIn true true = false := by
  intro fuel
  induction fuel with
  | zero => intro s h; simpa [Wnaf.loop] using h
  | succ f ih =>
    intro s h
    simp only [Wnaf.loop] at h
    split at h
    · exact h
    · have h2 := ih (Wnaf.step neg s) h
      obtain ⟨ha, hi, hu, ho⟩ := step_flags neg s
      simp only [Wnaf.State.panicsIn, Bool.true_and, Bool.or_eq_false_iff] at h2 ⊢
      rw [ha, hi, hu, ho] at h2
      simp only [Bool.or_eq_false_iff] at h2
      tauto

end Wnaf

open Aeneas Aeneas.Std

/-! ## Reading the translation's values -/

/-- The translation's digit array read as the model's digits: entry `i` as an integer. -/
def digitsOf (digits : Std.Array Std.I8 128#usize) : Fin 128 → ℤ :=
  fun i => (digits.val.getD i.val 0#i8).val

/-- The translation's return value `(digits, n)` read as the model's. -/
def readOut (r : Std.Array Std.I8 128#usize × Std.Usize) : (Fin 128 → ℤ) × ℕ :=
  (digitsOf r.1, r.2.val)

/-- The translation's loop state `(digits, n, k)` read as the model state `s`, flags aside. -/
private def LoopRel (digits : Std.Array Std.I8 128#usize) (n : Std.Usize) (k : Std.U128)
    (s : Wnaf.State) : Prop :=
  digitsOf digits = s.digits ∧ n.val = s.n ∧ k.val = s.k

/-! ## The translation's primitives -/

/-- The loop's three readings of `k`: `k != 0` holds exactly when `k ≠ 0`, `k & 1 == 1` exactly
when `k` is odd, and `(k & 0xF) as i8` is `k mod 16`. -/
private theorem kbits (k : Std.U128) :
    ((k != 0#u128) = true ↔ k.val ≠ 0) ∧ (k &&& 1#u128 = 1#u128 ↔ k.val % 2 = 1) ∧
      (UScalar.hcast IScalarTy.I8 (k &&& 15#u128)).val = ((k.val % 16 : ℕ) : ℤ) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [bne_iff_ne, ne_eq, ne_eq, not_iff_not]
    constructor
    · intro h
      rw [h]
      rfl
    · intro h
      exact UScalar.eq_of_val_eq (by rw [h]; rfl)
  · constructor
    · intro h
      have h2 := UScalar.val_eq_of_eq h
      simp [Nat.and_one_is_mod] at h2
      exact h2
    · intro h
      apply UScalar.eq_of_val_eq
      simp [Nat.and_one_is_mod, h]
  · have h15 : k.val &&& 15 = k.val % 16 := Nat.and_two_pow_sub_one_eq_mod k.val 4
    have hlt : k.val % 16 < 16 := Nat.mod_lt _ (by norm_num)
    rw [UScalar.hcast_val_eq, UScalar.val_and, UScalar.ofNatCore_val_eq, h15,
      IScalarTy.I8_numBits_eq, Int.bmod_def]
    split_ifs <;> omega

/-- Writing `x` at a position `n < 128` of the digit array changes the model's digit `n` to `x`
and no other digit. -/
private theorem digitsOf_set (digits : Std.Array Std.I8 128#usize) (n : Std.Usize) (x : Std.I8)
    (h : n.val < 128) :
    digitsOf (digits.set n x) = Function.update (digitsOf digits) ⟨n.val, h⟩ x.val := by
  funext i
  have hl : (digits.val).length = 128 := by simp
  by_cases hi : i = ⟨n.val, h⟩
  · subst hi
    simp only [digitsOf, Array.set_val_eq, Function.update_self]
    rw [List.getD_eq_getElem?_getD, List.getElem?_set]
    simp [hl, h]
  · rw [Function.update_of_ne hi]
    have hne : n.val ≠ i.val := fun e => hi (Fin.ext e.symm)
    simp only [digitsOf, Array.set_val_eq]
    rw [List.getD_eq_getElem?_getD, List.getElem?_set, if_neg hne, ← List.getD_eq_getElem?_getD]

/-- `[0i8; 128]` reads as the model's initial digits, all zero. -/
private theorem digitsOf_repeat : digitsOf (Std.Array.repeat 128#usize 0#i8) = fun _ => 0 := by
  funext i
  simp only [digitsOf, Array.repeat_val]
  rw [List.getD_replicate _ (by simp)]
  rfl

/-- The start of `wnaf_digits`: from `2^127` on the assertion fails; below it the loop starts from
`digits = [0; 128]`, `n = 0` and `k = a`. -/
private theorem wnaf_entry (a : Std.U128) (neg : Bool) :
    pasta_curves.glv.wnaf_digits a neg =
      if a.val < 2 ^ 127 then
        pasta_curves.glv.wnaf_digits_loop neg (Std.Array.repeat 128#usize 0#i8) 0#usize a
      else .fail .assertionFailure := by
  unfold pasta_curves.glv.wnaf_digits
  simp only [HShiftRight.hShiftRight, UScalar.shiftRight_IScalar, UScalar.shiftRight]
  simp only [massert, UScalar.eq_equiv]
  simp
  split_ifs with h1 h2 h2
  · simp
  · unfold UScalar.val at h1
    rw [BitVec.toNat_ushiftRight, UScalar.bv_toNat, Nat.shiftRight_eq_div_pow] at h1
    omega
  · unfold UScalar.val at h1
    rw [BitVec.toNat_ushiftRight, UScalar.bv_toNat, Nat.shiftRight_eq_div_pow] at h1
    omega
  · simp

/-- One unfolding of Aeneas' `loop`: when the body continues, the loop goes on from the body's new
state; when the body is done, the loop returns the body's value. -/
private theorem loop_unfold (neg : Bool) (digits : Std.Array Std.I8 128#usize) (n : Std.Usize)
    (k : Std.U128) :
    (∀ (neg' : Bool) (digits' : Std.Array Std.I8 128#usize) (n' : Std.Usize) (k' : Std.U128),
      pasta_curves.glv.wnaf_digits_loop.body neg digits n k =
          .ok (.cont (neg', digits', n', k')) →
        pasta_curves.glv.wnaf_digits_loop neg digits n k =
          pasta_curves.glv.wnaf_digits_loop neg' digits' n' k') ∧
    (∀ v, pasta_curves.glv.wnaf_digits_loop.body neg digits n k = .ok (.done v) →
      pasta_curves.glv.wnaf_digits_loop neg digits n k = .ok v) := by
  constructor
  · intro neg' digits' n' k' h
    conv_lhs => unfold pasta_curves.glv.wnaf_digits_loop
    rw [Aeneas.Std.loop]
    simp only [h, bind_ok]
    rfl
  · intro v h
    unfold pasta_curves.glv.wnaf_digits_loop
    rw [Aeneas.Std.loop]
    simp only [h, bind_ok]

/-- The body at `k = 0`: the loop is done and returns `(digits, n)`. -/
private theorem body_zero (neg : Bool) (digits : Std.Array Std.I8 128#usize) (n : Std.Usize)
    (k : Std.U128) (hk : k.val = 0) :
    pasta_curves.glv.wnaf_digits_loop.body neg digits n k = .ok (.done (digits, n)) := by
  unfold pasta_curves.glv.wnaf_digits_loop.body
  rw [if_neg (fun h => (kbits k).1.mp h hk)]

open Aeneas.Std.WP in
/-- The body on an even nonzero `k` with `n < 128`: no write, then `n + 1` and `k >> 1`, neither
of which fails. -/
private theorem body_even (neg : Bool) (digits : Std.Array Std.I8 128#usize) (n : Std.Usize)
    (k : Std.U128) (hk0 : k.val ≠ 0) (hk : k.val % 2 = 0) (hn : n.val < 128) :
    ∃ (n' : Std.Usize) (k' : Std.U128),
      pasta_curves.glv.wnaf_digits_loop.body neg digits n k = .ok (.cont (neg, digits, n', k')) ∧
      n'.val = n.val + 1 ∧ k'.val = k.val / 2 := by
  suffices H : pasta_curves.glv.wnaf_digits_loop.body neg digits n k ⦃ r =>
      ∃ (n' : Std.Usize) (k' : Std.U128), r = .cont (neg, digits, n', k') ∧
        n'.val = n.val + 1 ∧ k'.val = k.val / 2 ⦄ by
    obtain ⟨r, hr, n', k', rfl, h⟩ := WP.spec_imp_exists H
    exact ⟨n', k', hr, h⟩
  unfold pasta_curves.glv.wnaf_digits_loop.body
  rw [if_pos ((kbits k).1.mpr hk0)]
  simp only [lift, bind_ok]
  rw [if_neg (fun h => by have := (kbits k).2.1.mp h; omega)]
  step*
  refine ⟨_, _, rfl, ?_, ?_⟩
  · scalar_tac
  · simp only [Nat.shiftRight_eq_div_pow, pow_one] at *
    omega

open Aeneas.Std.WP in
/-- The body on an odd `k` with `n < 128` and `k - d < 2^128`: it writes the digit
`d = wdigit k`, negated when `neg`, at position `n`, and continues with `n + 1` and `knext k`;
none of its checked operations fails. The proof splits on the three tests (`low >= 8`, `negate`,
`d >= 0`) and ends each feasible branch in arithmetic on `k mod 16`. -/
private theorem body_odd (neg : Bool) (digits : Std.Array Std.I8 128#usize) (n : Std.Usize)
    (k : Std.U128) (hn : n.val < 128) (hk : k.val % 2 = 1)
    (hover : (k.val : ℤ) - Wnaf.wdigit k.val < 2 ^ 128) :
    ∃ (d : Std.I8) (n' : Std.Usize) (k' : Std.U128),
      pasta_curves.glv.wnaf_digits_loop.body neg digits n k =
        .ok (.cont (neg, digits.set n d, n', k')) ∧
      d.val = (if neg then -Wnaf.wdigit k.val else Wnaf.wdigit k.val) ∧
      n'.val = n.val + 1 ∧ k'.val = Wnaf.knext k.val := by
  have hk0 := (kbits k).1.mpr (by omega)
  have h1 := (kbits k).2.1.mpr hk
  have hlow := (kbits k).2.2
  have hp : (2 : ℤ) ^ 128 = 340282366920938463463374607431768211456 := by norm_num
  suffices H : pasta_curves.glv.wnaf_digits_loop.body neg digits n k ⦃ r =>
      ∃ (d : Std.I8) (n' : Std.Usize) (k' : Std.U128), r = .cont (neg, digits.set n d, n', k') ∧
      d.val = (if neg then -Wnaf.wdigit k.val else Wnaf.wdigit k.val) ∧
      n'.val = n.val + 1 ∧ k'.val = Wnaf.knext k.val ⦄ by
    obtain ⟨r, hr, d, n', k', rfl, h⟩ := WP.spec_imp_exists H
    exact ⟨d, n', k', hr, h⟩
  unfold pasta_curves.glv.wnaf_digits_loop.body
  rw [if_pos hk0]
  simp only [lift, bind_ok]
  rw [if_pos h1]
  step*
  all_goals (try split)
  all_goals (try step*)
  all_goals (try split)
  all_goals (try step*)
  all_goals (try split)
  all_goals (try step*)
  all_goals (try subst_vars)
  all_goals (try refine ⟨_, _, _, rfl, ?_, ?_, ?_⟩)
  all_goals (simp only [IScalar.hcast_val_eq, UScalarTy.U128_numBits_eq, U128.max_eq,
    Nat.shiftRight_eq_div_pow, Wnaf.knext, Wnaf.wdigit, wrapU128, pow_one, hp, ge_iff_le,
    IScalar.le_equiv, IScalar.ofInt_val_eq, not_le] at *)
  all_goals (split_ifs at * <;> omega)

/-! ## The loop -/

/-- One pass: from a state related to `s` with `k ≠ 0` and `n < 128`, where the model's pass sets
no flag, the body continues to a state related to `Wnaf.step neg s`: an even `k` by `body_even`,
an odd one by `body_odd`, whose bound on `k - d` is the model's clear `u128` flag. -/
private theorem body_step (neg : Bool) (digits : Std.Array Std.I8 128#usize) (n : Std.Usize)
    (k : Std.U128) (s : Wnaf.State) (hrel : LoopRel digits n k s) (hk0 : k.val ≠ 0)
    (hn128 : n.val < 128) (hp : (Wnaf.step neg s).panicsIn true true = false) :
    ∃ (digits' : Std.Array Std.I8 128#usize) (n' : Std.Usize) (k' : Std.U128),
      pasta_curves.glv.wnaf_digits_loop.body neg digits n k =
        .ok (.cont (neg, digits', n', k')) ∧
      LoopRel digits' n' k' (Wnaf.step neg s) := by
  obtain ⟨hdig, hnn, hkk⟩ := hrel
  rcases Nat.mod_two_eq_zero_or_one k.val with hev | hod
  · obtain ⟨n', k', hbody, hn', hk'⟩ := body_even neg digits n k hk0 hev hn128
    refine ⟨digits, n', k', hbody, ?_, ?_, ?_⟩
    · funext i
      rw [Wnaf.step_digits neg s i, if_neg (by omega), hdig]
    · rw [Wnaf.step_n neg s]
      omega
    · rw [Wnaf.step_k neg s, Wnaf.knext, if_neg (by omega), hk', hkk]
  · have hover : (k.val : ℤ) - Wnaf.wdigit k.val < 2 ^ 128 := by
      obtain ⟨-, -, hu, -⟩ := Wnaf.step_flags neg s
      simp only [Wnaf.State.panicsIn, Bool.true_and, Bool.or_eq_false_iff] at hp
      have h2 := hp.1.2.1
      rw [hu] at h2
      simp only [Bool.or_eq_false_iff, Bool.and_eq_false_iff, decide_eq_false_iff_not] at h2
      rw [← hkk] at h2
      omega
    obtain ⟨d, n', k', hbody, hdv, hn', hk'⟩ := body_odd neg digits n k hn128 hod hover
    refine ⟨digits.set n d, n', k', hbody, ?_, ?_, ?_⟩
    · rw [digitsOf_set digits n d hn128]
      funext i
      rw [Wnaf.step_digits neg s i]
      by_cases hi : i = ⟨n.val, hn128⟩
      · subst hi
        rw [Function.update_self, if_pos ⟨by omega, hnn⟩, hdv, hkk]
      · rw [Function.update_of_ne hi,
          if_neg (fun ⟨_, h2⟩ => hi (Fin.ext (show i.val = n.val by omega))), hdig]
    · rw [Wnaf.step_n neg s]
      omega
    · rw [Wnaf.step_k neg s, hk', hkk]

/-- The loop: from a state related to `s`, with fuel at least `k`, where the model's loop from `s`
ends with no flag set and `n ≤ 128`, the translated loop returns the model's `(digits, n)`. By
induction on the fuel: at `k = 0` both loops stop, and otherwise one body run is one model pass
(`body_step`), after which the loop goes on (`loop_unfold`). The model's run from the next state
still ends with no flag and `n ≤ 128`, so the pass itself sets no flag (`loop_clear`) and starts
below position 128 (`loop_n_le`). -/
private theorem loop_ok (neg : Bool) : ∀ (fuel : ℕ) (s : Wnaf.State)
    (digits : Std.Array Std.I8 128#usize) (n : Std.Usize) (k : Std.U128), s.k ≤ fuel →
    LoopRel digits n k s → (Wnaf.loop neg fuel s).panicsIn true true = false →
    (Wnaf.loop neg fuel s).n ≤ 128 →
      ∃ r, pasta_curves.glv.wnaf_digits_loop neg digits n k = .ok r ∧
        readOut r = ((Wnaf.loop neg fuel s).digits, (Wnaf.loop neg fuel s).n) := by
  intro fuel
  induction fuel with
  | zero =>
    intro s digits n k hle hrel _ _
    obtain ⟨hdig, hnn, hkk⟩ := hrel
    rw [(loop_unfold neg digits n k).2 _ (body_zero neg digits n k (by omega))]
    exact ⟨_, rfl, by simp [Wnaf.loop, readOut, hdig, hnn]⟩
  | succ f ih =>
    intro s digits n k hle hrel hp hn128
    obtain ⟨hdig, hnn, hkk⟩ := hrel
    by_cases hs0 : s.k = 0
    · rw [(loop_unfold neg digits n k).2 _ (body_zero neg digits n k (by omega))]
      exact ⟨_, rfl, by simp [Wnaf.loop, hs0, readOut, hdig, hnn]⟩
    · have hloop : Wnaf.loop neg (f + 1) s = Wnaf.loop neg f (Wnaf.step neg s) := by
        simp [Wnaf.loop, hs0]
      rw [hloop] at hp hn128 ⊢
      have hsp := Wnaf.loop_clear neg f (Wnaf.step neg s) hp
      have hsn := Wnaf.loop_n_le neg f (Wnaf.step neg s)
      rw [Wnaf.step_n neg s] at hsn
      obtain ⟨digits', n', k', hbody, hrel'⟩ :=
        body_step neg digits n k s ⟨hdig, hnn, hkk⟩ (by omega) (by omega) hsp
      rw [(loop_unfold neg digits n k).1 _ _ _ _ hbody]
      exact ih (Wnaf.step neg s) digits' n' k' (by have := Wnaf.step_k_lt neg s hs0; omega)
        hrel' hp hn128

/-! ## The refinement -/

/-- Below `2^127` the model sets no flag. -/
private theorem panics_false (a : ℕ) (neg : Bool) (ha : a < 2 ^ 127) :
    (Wnaf.exec a neg).panicsIn true true = false := by
  obtain ⟨af, oob, u, i8⟩ := wnaf_digits_no_panic a neg ha
  simp [Wnaf.State.panicsIn, af, oob, u, i8]

/-- Aeneas' translation of `wnaf_digits` against the model, exactly: on every `u128` magnitude
and sign, where the model says a debug build panics, the translation fails, at the assertion;
elsewhere it returns the model's `(digits, n)`. So it never diverges. -/
theorem wnaf_digits_refines (a : Std.U128) (neg : Bool) :
    ((Wnaf.exec a.val neg).panicsIn true true = true →
      pasta_curves.glv.wnaf_digits a neg = .fail .assertionFailure) ∧
    ((Wnaf.exec a.val neg).panicsIn true true = false →
      ∃ r, pasta_curves.glv.wnaf_digits a neg = .ok r ∧ readOut r = Wnaf.run a.val neg) := by
  by_cases ha : a.val < 2 ^ 127
  · have hp := panics_false a.val neg ha
    refine ⟨fun h => by rw [hp] at h; exact absurd h Bool.false_ne_true, fun _ => ?_⟩
    rw [wnaf_entry a neg, if_pos ha]
    have hrel : LoopRel (Std.Array.repeat 128#usize 0#i8) 0#usize a (Wnaf.init a.val) :=
      ⟨digitsOf_repeat, rfl, rfl⟩
    exact loop_ok neg a.val (Wnaf.init a.val) _ _ _ le_rfl hrel hp
      (wnaf_digits_length_le_128 a.val neg ha)
  · have ha128 : a.val < 2 ^ 128 := by scalar_tac
    have haf : (Wnaf.exec a.val neg).assertFailed = true :=
      ((wnaf_digits_checks a.val neg ha128).1).2 (by omega)
    have hp : (Wnaf.exec a.val neg).panicsIn true true = true := by
      simp [Wnaf.State.panicsIn, haf]
    refine ⟨fun _ => by rw [wnaf_entry a neg, if_neg ha], fun h => ?_⟩
    rw [hp] at h
    exact absurd h.symm Bool.false_ne_true

/-- Aeneas' translation of `wnaf_digits` against the model, its outcome read as an `Option`: on
every `u128` magnitude and sign, the translation fails exactly when the model says a debug build
panics, and otherwise returns the model's `(digits, n)`. -/
theorem wnaf_digits_refines_ofResult (a : Std.U128) (neg : Bool) :
    (Option.ofResult (pasta_curves.glv.wnaf_digits a neg)).map readOut =
      if (Wnaf.exec a.val neg).panicsIn true true then none else some (Wnaf.run a.val neg) := by
  obtain ⟨h1, h2⟩ := wnaf_digits_refines a neg
  cases hp : (Wnaf.exec a.val neg).panicsIn true true
  · obtain ⟨r, hr, hro⟩ := h2 hp
    simp [hr, Option.ofResult, hro]
  · simp [h1 hp, Option.ofResult]

/-- Aeneas' translation of `wnaf_digits` on a magnitude below `2^127` returns, and its value is
the model's `(digits, n)`. -/
theorem wnaf_digits_refines_of_lt (a : Std.U128) (neg : Bool) (ha : a.val < 2 ^ 127) :
    ∃ r, pasta_curves.glv.wnaf_digits a neg = .ok r ∧ readOut r = Wnaf.run a.val neg := by
  have h := wnaf_digits_refines_ofResult a neg
  rw [panics_false a.val neg ha] at h
  obtain ⟨r, hr, hro⟩ := Option.map_eq_some_iff.mp h
  refine ⟨r, ?_, hro⟩
  unfold Option.ofResult at hr
  split at hr
  · rename_i r' hm
    obtain rfl := Option.some.inj hr
    exact Result.match.isOk.mp hm
  · exact absurd hr (by simp)

end PastaCurves.Glv
