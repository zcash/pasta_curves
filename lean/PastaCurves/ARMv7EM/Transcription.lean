/-- Inputs and outputs of the mechanically factored final five instructions of a batch round. -/
structure BatchRoundFinish where
  pglo : Nat
  pghi : Nat
  remaining : Nat
  c : Nat
  z : Nat
  branch : Nat
  deriving DecidableEq, Repr
/-- The final five instructions of one validated `batch` loop iteration: shift packed `g`, decrement
the public count, and compute the backward-branch decision. -/
def batchRoundFinish (pglo pghi remaining : Nat) : BatchRoundFinish :=
  let pglo := pglo                  -- input pglo
  let pghi := pghi                  -- input pghi
  let remaining := remaining        -- input remaining
  let tmp := lsr32 pglo 1           -- lsr.w {tmp}, {pglo}, #1
  let pglo := orr32 tmp (lsl32 pghi 31)  -- orr.w {pglo}, {tmp}, {pghi}, lsl #31
  let pghi := asr32 pghi 1          -- asr.w {pghi}, {pghi}, #1
  let sub := subc32 remaining 1 1   -- subs {remaining}, {remaining}, #1
  let remaining := sub.1            --   `-> remaining
  let c := sub.2                    --   `-> carry
  let z := (if remaining = 0 then 1 else 0)  --   `-> zero
  let branch := (if z = 0 then 1 else 0)  -- bne 2b
  ⟨pglo, pghi, remaining, c, z, branch⟩

/-- The registers and public loop control carried by one `batch` round. -/
structure BatchState where
  /-- The low word of packed `f`. -/
  pflo : Nat
  /-- The high word of packed `f`. -/
  pfhi : Nat
  /-- The low word of packed `g`. -/
  pglo : Nat
  /-- The high word of packed `g`. -/
  pghi : Nat
  /-- `two_delta`, in its low 32-bit register. -/
  d : Nat
  /-- The public number of rounds still to execute. -/
  remaining : Nat
  /-- The carry flag left by the decrement. -/
  c : Nat
  /-- The zero flag left by the decrement. -/
  z : Nat
  /-- Whether the source's backward branch is taken. -/
  branch : Nat
  deriving DecidableEq, Repr
/-- One complete iteration of the inline `asm!` loop of `batch`, including its public-count
decrement, resulting flags, and backward-branch decision. -/
def batchRound (st : BatchState) : BatchState :=
  let pflo := st.pflo               -- input pflo
  let pfhi := st.pfhi               -- input pfhi
  let pglo := st.pglo               -- input pglo
  let pghi := st.pghi               -- input pghi
  let d := st.d                     -- input d
  let remaining := st.remaining     -- input remaining
  let odd := andw pglo 1            -- and {odd}, {pglo}, #1
  let odd := (0 + wordMod - odd) % wordMod  -- rsb.w {odd}, {odd}, #0
  let sub := subc32 0 d 1           -- rsbs {tmp}, {d}, #0
  let tmp := sub.1                  -- rsbs {tmp}, {d}, #0
  let swap := asr32 tmp 31          -- asr.w {swap}, {tmp}, #31
  let swap := andw swap odd         -- and.w {swap}, {swap}, {odd}
  let alo := andw pflo odd          -- and.w {alo}, {pflo}, {odd}
  let ahi := andw pfhi odd          -- and.w {ahi}, {pfhi}, {odd}
  let alo := eor32 alo swap         -- eor.w {alo}, {alo}, {swap}
  let ahi := eor32 ahi swap         -- eor.w {ahi}, {ahi}, {swap}
  let tmp := andw swap 1            -- and.w {tmp}, {swap}, #1
  let s := addc32 alo tmp 0         -- adds {alo}, {alo}, {tmp}
  let alo := s.1                    --   `-> alo
  let c := s.2                      --   `-> carry
  let tmp := 0                      -- mov.w {tmp}, #0
  let ahi := (addc32 ahi tmp c).1   -- adc.w {ahi}, {ahi}, {tmp}
  let tmp := (2 + wordMod - d) % wordMod  -- rsb.w {tmp}, {d}, #2
  let d := (d + 2) % wordMod        -- add.w {d}, {d}, #2
  let tmp := eor32 tmp d            -- eor.w {tmp}, {tmp}, {d}
  let tmp := andw tmp swap          -- and.w {tmp}, {tmp}, {swap}
  let d := eor32 d tmp              -- eor.w {d}, {d}, {tmp}
  let tmp := eor32 pflo pglo        -- eor.w {tmp}, {pflo}, {pglo}
  let tmp := andw tmp swap          -- and.w {tmp}, {tmp}, {swap}
  let pflo := eor32 pflo tmp        -- eor.w {pflo}, {pflo}, {tmp}
  let tmp := eor32 pfhi pghi        -- eor.w {tmp}, {pfhi}, {pghi}
  let tmp := andw tmp swap          -- and.w {tmp}, {tmp}, {swap}
  let pfhi := eor32 pfhi tmp        -- eor.w {pfhi}, {pfhi}, {tmp}
  let s := addc32 pglo alo 0        -- adds {pglo}, {pglo}, {alo}
  let pglo := s.1                   --   `-> pglo
  let c := s.2                      --   `-> carry
  let pghi := (addc32 pghi ahi c).1  -- adc.w {pghi}, {pghi}, {ahi}
  let finish := batchRoundFinish pglo pghi remaining  -- mechanically factored PCs 27 through 31
  let pglo := finish.pglo           -- factored suffix output
  let pghi := finish.pghi           -- factored suffix output
  let remaining := finish.remaining  -- factored suffix output
  let c := finish.c                 -- factored suffix output
  let z := finish.z                 -- factored suffix output
  let branch := finish.branch       -- factored suffix output
  ⟨pflo, pfhi, pglo, pghi, d, remaining, c, z, branch⟩

/-- The inline `asm!` block and surrounding Rust of `batch`: pack the low words, iterate the
mechanically transcribed loop body by its public positive count `k`, sign-extend the new
`two_delta`, and decode the two packed matrix rows. -/
def batchBlock (k delta f g : Nat) : Divstep59Result :=
  let pf := orrw (andw f 0xfffff) 0xfffffe0000000000  -- pack the low word of f
  let pg := orrw (andw g 0xfffff) 0xc000000000000000  -- pack the low word of g
  let pflo := pf % wordMod          -- Rust cast to the low u32
  let pfhi := pf / wordMod          -- Rust shift and cast to the high u32
  let pglo := pg % wordMod          -- Rust cast to the low u32
  let pghi := pg / wordMod          -- Rust shift and cast to the high u32
  let d := delta % wordMod          -- Rust cast of two_delta to u32
  let st := (⟨pflo, pfhi, pglo, pghi, d, k, 0, 0, 0⟩ : BatchState)  -- initial assembly registers and flags
  let st := batchRound^[k] st       -- public-count assembly loop
  let pf := join32 st.pflo st.pfhi  -- join the returned packed f words
  let pg := join32 st.pglo st.pghi  -- join the returned packed g words
  let delta := signExtend32 st.d    -- sign-extend the returned u32
  let uv := unpackWords k pf        -- Rust unpack(k, pf)
  let qr := unpackWords k pg        -- Rust unpack(k, pg)
  ⟨delta, uv.1, uv.2, qr.1, qr.2⟩

/-- The Rust `divstep59` composition: packed batches of 20, 20, and 19 divsteps, with the next low
words between them and the newest transition matrix multiplied on the left. -/
def divstep59Block (two_delta f0 g0 : Nat) : Divstep59Result :=
  let b1 := batchBlock 20 two_delta f0 g0  -- batch(20, two_delta, f0, g0)
  let d1 := b1.two_delta            -- first batch output
  let u1 := b1.u                    -- first batch output
  let v1 := b1.v                    -- first batch output
  let q1 := b1.q                    -- first batch output
  let r1 := b1.r                    -- first batch output
  let f1 := nextLowWords 20 u1 v1 f0 g0  -- next_low for f after batch one
  let g1 := nextLowWords 20 q1 r1 f0 g0  -- next_low for g after batch one
  let b2 := batchBlock 20 d1 f1 g1  -- batch(20, d1, f1, g1)
  let d2 := b2.two_delta            -- second batch output
  let u2 := b2.u                    -- second batch output
  let v2 := b2.v                    -- second batch output
  let q2 := b2.q                    -- second batch output
  let r2 := b2.r                    -- second batch output
  let f2 := nextLowWords 20 u2 v2 f1 g1  -- next_low for f after batch two
  let g2 := nextLowWords 20 q2 r2 f1 g1  -- next_low for g after batch two
  let b3 := batchBlock 19 d2 f2 g2  -- batch(19, d2, f2, g2)
  let m21 := matMulWords (u2, v2, q2, r2) (u1, v1, q1, r1)  -- inner Rust mat_mul
  let matrix := matMulWords (b3.u, b3.v, b3.q, b3.r) m21  -- outer Rust mat_mul
  ⟨b3.two_delta, matrix.1, matrix.2.1, matrix.2.2.1, matrix.2.2.2⟩

/-- The inline `asm!` block of `cond_sub`: subtract the modulus from `value` as eight 32-bit words,
then use the final borrow as a mask to select the original value or the difference without a branch.
-/
def condSub (value modulus : Limbs) : Limbs :=
  let value_0 := value.l0 % wordMod  -- input value[0]
  let value_4 := value.l0 / wordMod  -- input value[4]
  let value_8 := value.l1 % wordMod  -- input value[8]
  let value_12 := value.l1 / wordMod  -- input value[12]
  let value_16 := value.l2 % wordMod  -- input value[16]
  let value_20 := value.l2 / wordMod  -- input value[20]
  let value_24 := value.l3 % wordMod  -- input value[24]
  let value_28 := value.l3 / wordMod  -- input value[28]
  let modulus_0 := modulus.l0 % wordMod  -- input modulus[0]
  let modulus_4 := modulus.l0 / wordMod  -- input modulus[4]
  let modulus_8 := modulus.l1 % wordMod  -- input modulus[8]
  let modulus_12 := modulus.l1 / wordMod  -- input modulus[12]
  let modulus_16 := modulus.l2 % wordMod  -- input modulus[16]
  let modulus_20 := modulus.l2 / wordMod  -- input modulus[20]
  let modulus_24 := modulus.l3 % wordMod  -- input modulus[24]
  let modulus_28 := modulus.l3 / wordMod  -- input modulus[28]
  -- zero-initialized out[0]: out_0 = 0 is never read
  -- zero-initialized out[4]: out_4 = 0 is never read
  -- zero-initialized out[8]: out_8 = 0 is never read
  -- zero-initialized out[12]: out_12 = 0 is never read
  -- zero-initialized out[16]: out_16 = 0 is never read
  -- zero-initialized out[20]: out_20 = 0 is never read
  -- zero-initialized out[24]: out_24 = 0 is never read
  -- zero-initialized out[28]: out_28 = 0 is never read
  let r2 := value_0                 -- ldr r2, [{value}, #0]
  let r3 := modulus_0               -- ldr r3, [{modulus}, #0]
  let d := subc32 r2 r3 1           -- subs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_0 := r2                   -- str r2, [{out}, #0]
  let r2 := value_4                 -- ldr r2, [{value}, #4]
  let r3 := modulus_4               -- ldr r3, [{modulus}, #4]
  let d := subc32 r2 r3 c           -- sbcs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_4 := r2                   -- str r2, [{out}, #4]
  let r2 := value_8                 -- ldr r2, [{value}, #8]
  let r3 := modulus_8               -- ldr r3, [{modulus}, #8]
  let d := subc32 r2 r3 c           -- sbcs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_8 := r2                   -- str r2, [{out}, #8]
  let r2 := value_12                -- ldr r2, [{value}, #12]
  let r3 := modulus_12              -- ldr r3, [{modulus}, #12]
  let d := subc32 r2 r3 c           -- sbcs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_12 := r2                  -- str r2, [{out}, #12]
  let r2 := value_16                -- ldr r2, [{value}, #16]
  let r3 := modulus_16              -- ldr r3, [{modulus}, #16]
  let d := subc32 r2 r3 c           -- sbcs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_16 := r2                  -- str r2, [{out}, #16]
  let r2 := value_20                -- ldr r2, [{value}, #20]
  let r3 := modulus_20              -- ldr r3, [{modulus}, #20]
  let d := subc32 r2 r3 c           -- sbcs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_20 := r2                  -- str r2, [{out}, #20]
  let r2 := value_24                -- ldr r2, [{value}, #24]
  let r3 := modulus_24              -- ldr r3, [{modulus}, #24]
  let d := subc32 r2 r3 c           -- sbcs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_24 := r2                  -- str r2, [{out}, #24]
  let r2 := value_28                -- ldr r2, [{value}, #28]
  let r3 := modulus_28              -- ldr r3, [{modulus}, #28]
  let d := subc32 r2 r3 c           -- sbcs r2, r2, r3
  let r2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let out_28 := r2                  -- str r2, [{out}, #28]
  let keep := 0                     -- mov.w {keep}, #0
  let keep := (subc32 keep keep c).1  -- sbc.w {keep}, {keep}, {keep}
  let r2 := out_0                   -- ldr r2, [{out}, #0]
  let r3 := value_0                 -- ldr r3, [{value}, #0]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_0 := r2                   -- str r2, [{out}, #0]
  let r2 := out_4                   -- ldr r2, [{out}, #4]
  let r3 := value_4                 -- ldr r3, [{value}, #4]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_4 := r2                   -- str r2, [{out}, #4]
  let r2 := out_8                   -- ldr r2, [{out}, #8]
  let r3 := value_8                 -- ldr r3, [{value}, #8]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_8 := r2                   -- str r2, [{out}, #8]
  let r2 := out_12                  -- ldr r2, [{out}, #12]
  let r3 := value_12                -- ldr r3, [{value}, #12]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_12 := r2                  -- str r2, [{out}, #12]
  let r2 := out_16                  -- ldr r2, [{out}, #16]
  let r3 := value_16                -- ldr r3, [{value}, #16]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_16 := r2                  -- str r2, [{out}, #16]
  let r2 := out_20                  -- ldr r2, [{out}, #20]
  let r3 := value_20                -- ldr r3, [{value}, #20]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_20 := r2                  -- str r2, [{out}, #20]
  let r2 := out_24                  -- ldr r2, [{out}, #24]
  let r3 := value_24                -- ldr r3, [{value}, #24]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_24 := r2                  -- str r2, [{out}, #24]
  let r2 := out_28                  -- ldr r2, [{out}, #28]
  let r3 := value_28                -- ldr r3, [{value}, #28]
  let r3 := eor32 r3 r2             -- eor r3, r3, r2
  let r3 := andw r3 keep            -- and r3, r3, {keep}
  let r2 := eor32 r2 r3             -- eor r2, r2, r3
  let out_28 := r2                  -- str r2, [{out}, #28]
  let result0 := out_0 + wordMod * out_4  -- combine output words
  let result1 := out_8 + wordMod * out_12  -- combine output words
  let result2 := out_16 + wordMod * out_20  -- combine output words
  let result3 := out_24 + wordMod * out_28  -- combine output words
  ⟨result0, result1, result2, result3⟩

end PastaCurves.ARMv7EM
