module
public import PastaCurves.ARMv7EM.Semantics
@[expose] public section

/-!
# The crate's inline ARMv7E-M word primitives, transcribed

GENERATED by `lean/scripts/gen.py` from the `asm!` blocks of `adc`, `add_word`,
`sbb`, `mac_word`, `inversion_mac_words`, `from_mont`, `batch`, and `cond_sub`,
and the Rust composition in `divstep59`, in `src/asm/armv7em.rs`; do not edit by
hand. Each assembly definition follows its source template instruction by
instruction, with the exact template as a trailing comment. Registers are
lexically rebound after each write and `c` models the ARM carry flag. The eight
macro-expanded `from_mont` rounds and its final reduction are factored from the
validated flat binding IR after checking the exact register rotations. The `batch`
loop is factored into one mechanically transcribed round iterated by its public count;
its decrement, flags,
and backward branch are retained in the round state. The generator checks operand
directions and instruction overlap constraints and rejects an uninitialized
register, flag, or fixed-offset memory read.
-/

namespace PastaCurves.ARMv7EM

/-- The Rust `unpack` helper, on a 64-bit word. -/
def unpackWords (k w : Nat) : Nat × Nat :=
  let t := (2^64 - w) % 2^64
  let up := asr (addw t (2^(40 - k))) (41 - k)
  let v := asr (addw up (2^20 - 1)) 21
  (subw up (lsl v 21), v)

/-- The Rust `next_low` helper: wrapping products and sum followed by a logical shift. -/
def nextLowWords (k a b f g : Nat) : Nat :=
  lsr (addw (a * f % 2^64) (b * g % 2^64)) k

/-- The Rust `mat_mul` helper, with every entry computed modulo `2^64`. -/
def matMulWords (m n : Nat × Nat × Nat × Nat) : Nat × Nat × Nat × Nat :=
  let (u, v, q, r) := m
  let (u', v', q', r') := n
  (addw (u * u' % 2^64) (v * q' % 2^64),
   addw (u * v' % 2^64) (v * r' % 2^64),
   addw (q * u' % 2^64) (r * q' % 2^64),
   addw (q * v' % 2^64) (r * r' % 2^64))

/-- The inline `asm!` block of `adc`: add two 32-bit words and a carry-in, returning the low word
and carry-out. -/
def adc (a b carry : Nat) : Nat × Nat :=
  let a := a                        -- input a
  let b := b                        -- input b
  let carry := carry                -- input carry
  let s := addc32 a b 0             -- adds {sum}, {a}, {b}
  let sum := s.1                    --   `-> sum
  let c := s.2                      --   `-> carry
  let carry_out := 0                -- mov {carry_out}, #0
  let carry_out := (addc32 carry_out 0 c).1  -- adc {carry_out}, {carry_out}, #0
  let s := addc32 sum carry 0       -- adds {sum}, {sum}, {carry}
  let sum := s.1                    --   `-> sum
  let c := s.2                      --   `-> carry
  let carry_out := (addc32 carry_out 0 c).1  -- adc {carry_out}, {carry_out}, #0
  (sum, carry_out)

/-- The inline `asm!` block of `add_word`: add two 32-bit words, returning the low word and
carry-out. -/
def addWord (a b : Nat) : Nat × Nat :=
  let a := a                        -- input a
  let b := b                        -- input b
  let s := addc32 a b 0             -- adds {sum}, {a}, {b}
  let sum := s.1                    --   `-> sum
  let c := s.2                      --   `-> carry
  let carry := 0                    -- mov {carry}, #0
  let carry := (addc32 carry 0 c).1  -- adc {carry}, {carry}, #0
  (sum, carry)

/-- The inline `asm!` block of `sbb`: subtract a 32-bit word and borrow-in, returning the low word
and borrow-out. -/
def sbb (a b borrow : Nat) : Nat × Nat :=
  let a := a                        -- input a
  let b := b                        -- input b
  let borrow := borrow              -- input borrow
  let d := subc32 0 borrow 1        -- rsbs {borrow}, {borrow}, #0
  -- rsbs {borrow}, {borrow}, #0: borrow = d.1 is never read
  let c := d.2                      --   `-> carry
  let d := subc32 a b c             -- sbcs {difference}, {a}, {b}
  let difference := d.1             --   `-> difference
  let c := d.2                      --   `-> carry
  let borrow_out := 0               -- mov {borrow_out}, #0
  let borrow_out := (addc32 borrow_out 0 c).1  -- adc {borrow_out}, {borrow_out}, #0
  let borrow_out := eor32 borrow_out 1  -- eor {borrow_out}, {borrow_out}, #1
  (difference, borrow_out)

/-- The inline `asm!` block of `mac_word`: multiply two 32-bit words, add an accumulator and carry,
and return the low and high words. -/
def macWord (acc a b carry : Nat) : Nat × Nat :=
  let low := acc                    -- input low
  let high := carry                 -- input high
  let a := a                        -- input a
  let b := b                        -- input b
  let m := umaal32 low high a b     -- umaal {low}, {high}, {a}, {b}
  let low := m.1                    --   `-> low
  let high := m.2                   --   `-> high
  (low, high)

/-- The inline `asm!` block of `inversion_mac_words`: add the four-word product `b * c` to the
four-word accumulator `r`, retaining every carry. -/
def inversionMacWords (r0 r1 b0 b1 c0 c1 r2 r3 : Nat) : Nat × Nat × Nat × Nat :=
  let r0 := r0                      -- input r0
  let r1 := r1                      -- input r1
  let r2 := r2                      -- input r2
  let r3 := r3                      -- input r3
  let c0 := c0                      -- input c0
  let b0 := b0                      -- input b0
  let b1 := b1                      -- input b1
  let c1 := c1                      -- input c1
  let m := umaal32 r0 r2 b0 c0      -- umaal {r0}, {r2}, {b0}, {c0}
  let r0 := m.1                     --   `-> r0
  let r2 := m.2                     --   `-> r2
  let m := umaal32 r1 r3 b0 c1      -- umaal {r1}, {r3}, {b0}, {c1}
  let r1 := m.1                     --   `-> r1
  let r3 := m.2                     --   `-> r3
  let m := umaal32 r1 r2 b1 c0      -- umaal {r1}, {r2}, {b1}, {c0}
  let r1 := m.1                     --   `-> r1
  let r2 := m.2                     --   `-> r2
  let c0 := 0                       -- mov {c0}, #0
  let s := addc32 r2 r3 0           -- adds {r2}, {r2}, {r3}
  let r2 := s.1                     --   `-> r2
  let c := s.2                      --   `-> carry
  let c0 := (addc32 c0 0 c).1       -- adc {c0}, {c0}, #0
  let r3 := 0                       -- mov {r3}, #0
  let m := umaal32 r2 r3 b1 c1      -- umaal {r2}, {r3}, {b1}, {c1}
  let r2 := m.1                     --   `-> r2
  let r3 := m.2                     --   `-> r3
  let r3 := (r3 + c0) % wordMod     -- add {r3}, {r3}, {c0}
  (r0, r1, r2, r3)

/-- The nine-word accumulator carried between `from_mont_round!` invocations. -/
structure FromMontState where
  w0 : Nat
  w1 : Nat
  w2 : Nat
  w3 : Nat
  w4 : Nat
  w5 : Nat
  w6 : Nat
  w7 : Nat
  w8 : Nat
  deriving DecidableEq, Repr

namespace FromMontState

/-- Every accumulator word is below `2^32`. -/
def Bounded (s : FromMontState) : Prop :=
  s.w0 < 2^32 ∧ s.w1 < 2^32 ∧ s.w2 < 2^32 ∧ s.w3 < 2^32 ∧ s.w4 < 2^32 ∧
    s.w5 < 2^32 ∧ s.w6 < 2^32 ∧ s.w7 < 2^32 ∧ s.w8 < 2^32

end FromMontState

/-- The quotient and low-word cancellation carry from the first three round instructions. -/
structure FromMontRoundPrefix where
  quotient : Nat
  carry : Nat
  deriving DecidableEq, Repr
/-- The first instruction of one checked `from_mont_round!` invocation: compute the Montgomery
quotient and the subtraction carry used by the next instruction. -/
def fromMontRoundPrefixQuotient (w0 : Nat) : Nat × Nat :=
  let w0 := w0                      -- low accumulator word
  let d := subc32 0 w0 1            -- rsbs.w r2, r2, #0
  let w0 := d.1                     -- rsbs.w r2, r2, #0
  let c := d.2                      --   `-> carry
  (w0, c)

/-- The second instruction of one checked `from_mont_round!` invocation: self-subtract the quotient
under the first instruction's carry. -/
def fromMontRoundPrefixSelfSub (quotient subCarry : Nat) : Nat :=
  let w0 := quotient                -- Montgomery quotient
  let c := subCarry                 -- subtraction carry
  let r12 := (subc32 w0 w0 c).1     -- sbc.w r12, r2, r2
  r12

/-- The third instruction of one checked `from_mont_round!` invocation: mask the self-subtraction
result to the low-word cancellation carry. -/
def fromMontRoundPrefixMask (selfSub : Nat) : Nat :=
  let r12 := selfSub                -- self-subtraction result
  let r12 := andw r12 1             -- and.w r12, r12, #1
  r12

/-- The first three instructions of one checked `from_mont_round!` invocation, composed from three
mechanically accounted one-instruction helpers: compute the quotient and the carry that cancels the
low accumulator word. -/
def fromMontRoundPrefix (w0 : Nat) : FromMontRoundPrefix :=
  let quotientResult := fromMontRoundPrefixQuotient w0  -- mechanically factored PC 0
  let quotient := quotientResult.1  -- quotient helper output
  let subCarry := quotientResult.2  -- quotient helper output
  let selfSub := fromMontRoundPrefixSelfSub quotient subCarry  -- mechanically factored PC 1
  let carry := fromMontRoundPrefixMask selfSub  -- mechanically factored PC 2
  ⟨quotient, carry⟩

/-- The final eighteen instructions of one checked `from_mont_round!` invocation: multiply the
sparse modulus by the quotient and propagate its carry through the accumulator. -/
def fromMontRoundSuffix (modulus : Limbs) (st : FromMontState) (q carry : Nat) : FromMontState :=
  -- input r1[0]: r1_0 = modulus.l0 % wordMod is never read
  let r1_4 := modulus.l0 / wordMod  -- input r1[4]
  let r1_8 := modulus.l1 % wordMod  -- input r1[8]
  let r1_12 := modulus.l1 / wordMod  -- input r1[12]
  -- input r1[16]: r1_16 = modulus.l2 % wordMod is never read
  -- input r1[20]: r1_20 = modulus.l2 / wordMod is never read
  -- input r1[24]: r1_24 = modulus.l3 % wordMod is never read
  -- input r1[28]: r1_28 = modulus.l3 / wordMod is never read
  let w1 := st.w1                   -- accumulator argument
  let w2 := st.w2                   -- accumulator argument
  let w3 := st.w3                   -- accumulator argument
  let w4 := st.w4                   -- accumulator argument
  let w5 := st.w5                   -- accumulator argument
  let w6 := st.w6                   -- accumulator argument
  let w7 := st.w7                   -- accumulator argument
  let w8 := st.w8                   -- accumulator argument
  let w0 := q                       -- Montgomery quotient
  let r12 := carry                  -- low-word cancellation carry
  let tmp := r1_4                   -- ldr.w r0, [r1, #4]
  let m := umaal32 w1 r12 tmp w0    -- umaal r3, r12, r0, r2
  let w1 := m.1                     --   `-> r3
  let r12 := m.2                    --   `-> r12
  let tmp := r1_8                   -- ldr.w r0, [r1, #8]
  let m := umaal32 w2 r12 tmp w0    -- umaal r4, r12, r0, r2
  let w2 := m.1                     --   `-> r4
  let r12 := m.2                    --   `-> r12
  let tmp := r1_12                  -- ldr.w r0, [r1, #12]
  let m := umaal32 w3 r12 tmp w0    -- umaal r5, r12, r0, r2
  let w3 := m.1                     --   `-> r5
  let r12 := m.2                    --   `-> r12
  let tmp := 0                      -- mov.w r0, #0
  let s := addc32 w4 r12 0          -- adds.w r8, r8, r12
  let w4 := s.1                     --   `-> r8
  let c := s.2                      --   `-> carry
  let r12 := (addc32 tmp tmp c).1   -- adc.w r12, r0, r0
  let s := addc32 w5 r12 0          -- adds.w r9, r9, r12
  let w5 := s.1                     --   `-> r9
  let c := s.2                      --   `-> carry
  let r12 := (addc32 tmp tmp c).1   -- adc.w r12, r0, r0
  let s := addc32 w6 r12 0          -- adds.w r10, r10, r12
  let w6 := s.1                     --   `-> r10
  let c := s.2                      --   `-> carry
  let r12 := (addc32 tmp tmp c).1   -- adc.w r12, r0, r0
  let tmp := 0x40000000             -- mov.w r0, #0x40000000
  let m := umaal32 w7 r12 tmp w0    -- umaal r11, r12, r0, r2
  let w7 := m.1                     --   `-> r11
  let r12 := m.2                    --   `-> r12
  let tmp := 0                      -- mov.w r0, #0
  let s := addc32 w8 r12 0          -- adds.w lr, lr, r12
  let w8 := s.1                     --   `-> r14
  let c := s.2                      --   `-> carry
  let tmp := (addc32 tmp tmp c).1   -- adc.w r0, r0, r0
  ⟨w1, w2, w3, w4, w5, w6, w7, w8, tmp⟩

/-- One `from_mont_round!` invocation, composed from the mechanically checked quotient prefix and
sparse multiply/carry suffix. All eight invocations are required to have the same binding IR after
applying their exact source register rotation. -/
def fromMontRound (modulus : Limbs) (st : FromMontState) : FromMontState :=
  let quotientResult := fromMontRoundPrefix st.w0  -- mechanically factored PCs 0 through 2
  let q := quotientResult.quotient  -- quotient prefix output
  let carry := quotientResult.carry  -- quotient prefix output
  let suffix := fromMontRoundSuffix modulus st q carry  -- mechanically factored PCs 3 through 20
  let w0 := suffix.w0               -- sparse suffix output
  let w1 := suffix.w1               -- sparse suffix output
  let w2 := suffix.w2               -- sparse suffix output
  let w3 := suffix.w3               -- sparse suffix output
  let w4 := suffix.w4               -- sparse suffix output
  let w5 := suffix.w5               -- sparse suffix output
  let w6 := suffix.w6               -- sparse suffix output
  let w7 := suffix.w7               -- sparse suffix output
  let w8 := suffix.w8               -- sparse suffix output
  ⟨w0, w1, w2, w3, w4, w5, w6, w7, w8⟩

/-- The subtraction words, final no-borrow carry, and mask produced by the factored final reduction. -/
structure FromMontFinalSubtraction where
  w0 : Nat
  w1 : Nat
  w2 : Nat
  w3 : Nat
  w4 : Nat
  w5 : Nat
  w6 : Nat
  w7 : Nat
  w8 : Nat
  carry : Nat
  mask : Nat
  deriving DecidableEq, Repr

namespace FromMontFinalSubtraction

/-- Every subtraction result, its carry, and its mask are below `2^32`. -/
def Bounded (s : FromMontFinalSubtraction) : Prop :=
  s.w0 < 2^32 ∧ s.w1 < 2^32 ∧ s.w2 < 2^32 ∧ s.w3 < 2^32 ∧ s.w4 < 2^32 ∧
    s.w5 < 2^32 ∧ s.w6 < 2^32 ∧ s.w7 < 2^32 ∧ s.w8 < 2^32 ∧
    s.carry < 2^32 ∧ s.mask < 2^32

end FromMontFinalSubtraction
/-- The first fourteen instructions of the checked `from_mont` final reduction: subtract the sparse
modulus and turn the final no-borrow carry into an add-back mask. -/
def fromMontFinalSubtractionBlock (modulus : Limbs) (st : FromMontState) : FromMontFinalSubtraction :=
  -- input r1[0]: r1_0 = modulus.l0 % wordMod is never read
  let r1_4 := modulus.l0 / wordMod  -- input r1[4]
  let r1_8 := modulus.l1 % wordMod  -- input r1[8]
  let r1_12 := modulus.l1 / wordMod  -- input r1[12]
  -- input r1[16]: r1_16 = modulus.l2 % wordMod is never read
  -- input r1[20]: r1_20 = modulus.l2 / wordMod is never read
  -- input r1[24]: r1_24 = modulus.l3 % wordMod is never read
  -- input r1[28]: r1_28 = modulus.l3 / wordMod is never read
  let w0 := st.w0                   -- post-round accumulator argument
  let w1 := st.w1                   -- post-round accumulator argument
  let w2 := st.w2                   -- post-round accumulator argument
  let w3 := st.w3                   -- post-round accumulator argument
  let w4 := st.w4                   -- post-round accumulator argument
  let w5 := st.w5                   -- post-round accumulator argument
  let w6 := st.w6                   -- post-round accumulator argument
  let w7 := st.w7                   -- post-round accumulator argument
  let w8 := st.w8                   -- post-round accumulator argument
  let d := subc32 w0 1 1            -- subs.w lr, lr, #1
  let w0 := d.1                     --   `-> r14
  let c := d.2                      --   `-> carry
  let r11 := r1_4                   -- ldr.w r11, [r1, #4]
  let d := subc32 w1 r11 c          -- sbcs.w r0, r0, r11
  let w1 := d.1                     --   `-> r0
  let c := d.2                      --   `-> carry
  let r11 := r1_8                   -- ldr.w r11, [r1, #8]
  let d := subc32 w2 r11 c          -- sbcs.w r2, r2, r11
  let w2 := d.1                     --   `-> r2
  let c := d.2                      --   `-> carry
  let r11 := r1_12                  -- ldr.w r11, [r1, #12]
  let d := subc32 w3 r11 c          -- sbcs.w r3, r3, r11
  let w3 := d.1                     --   `-> r3
  let c := d.2                      --   `-> carry
  let r11 := 0                      -- mov.w r11, #0
  let d := subc32 w4 r11 c          -- sbcs.w r4, r4, r11
  let w4 := d.1                     --   `-> r4
  let c := d.2                      --   `-> carry
  let d := subc32 w5 r11 c          -- sbcs.w r5, r5, r11
  let w5 := d.1                     --   `-> r5
  let c := d.2                      --   `-> carry
  let d := subc32 w6 r11 c          -- sbcs.w r8, r8, r11
  let w6 := d.1                     --   `-> r8
  let c := d.2                      --   `-> carry
  let r11 := 0x40000000             -- mov.w r11, #0x40000000
  let d := subc32 w7 r11 c          -- sbcs.w r9, r9, r11
  let w7 := d.1                     --   `-> r9
  let c := d.2                      --   `-> carry
  let r12 := (subc32 w8 w8 c).1     -- sbc.w r12, r10, r10
  ⟨w0, w1, w2, w3, w4, w5, w6, w7, w8, c, r12⟩

/-- The final seventeen instructions of the checked `from_mont` final reduction: add the sparse
modulus back under the subtraction helper's borrow mask. -/
def fromMontFinalAddBackBlock (modulus : Limbs) (sub : FromMontFinalSubtraction) : FromMontState :=
  -- input r1[0]: r1_0 = modulus.l0 % wordMod is never read
  let r1_4 := modulus.l0 / wordMod  -- input r1[4]
  let r1_8 := modulus.l1 % wordMod  -- input r1[8]
  let r1_12 := modulus.l1 / wordMod  -- input r1[12]
  -- input r1[16]: r1_16 = modulus.l2 % wordMod is never read
  -- input r1[20]: r1_20 = modulus.l2 / wordMod is never read
  -- input r1[24]: r1_24 = modulus.l3 % wordMod is never read
  -- input r1[28]: r1_28 = modulus.l3 / wordMod is never read
  let w0 := sub.w0                  -- subtraction helper output
  let w1 := sub.w1                  -- subtraction helper output
  let w2 := sub.w2                  -- subtraction helper output
  let w3 := sub.w3                  -- subtraction helper output
  let w4 := sub.w4                  -- subtraction helper output
  let w5 := sub.w5                  -- subtraction helper output
  let w6 := sub.w6                  -- subtraction helper output
  let w7 := sub.w7                  -- subtraction helper output
  let w8 := sub.w8                  -- subtraction helper output
  let r12 := sub.mask               -- subtraction borrow mask
  let r11 := andw r12 1             -- and.w r11, r12, #1
  let s := addc32 w0 r11 0          -- adds.w lr, lr, r11
  let w0 := s.1                     --   `-> r14
  let c := s.2                      --   `-> carry
  let r11 := r1_4                   -- ldr.w r11, [r1, #4]
  let r11 := andw r11 r12           -- and.w r11, r11, r12
  let adcs_pair := addc32 w1 r11 c  -- adcs.w r0, r0, r11
  let w1 := adcs_pair.1             --   `-> r0
  let c := adcs_pair.2              --   `-> carry
  let r11 := r1_8                   -- ldr.w r11, [r1, #8]
  let r11 := andw r11 r12           -- and.w r11, r11, r12
  let adcs_pair := addc32 w2 r11 c  -- adcs.w r2, r2, r11
  let w2 := adcs_pair.1             --   `-> r2
  let c := adcs_pair.2              --   `-> carry
  let r11 := r1_12                  -- ldr.w r11, [r1, #12]
  let r11 := andw r11 r12           -- and.w r11, r11, r12
  let adcs_pair := addc32 w3 r11 c  -- adcs.w r3, r3, r11
  let w3 := adcs_pair.1             --   `-> r3
  let c := adcs_pair.2              --   `-> carry
  let r11 := 0                      -- mov.w r11, #0
  let adcs_pair := addc32 w4 r11 c  -- adcs.w r4, r4, r11
  let w4 := adcs_pair.1             --   `-> r4
  let c := adcs_pair.2              --   `-> carry
  let adcs_pair := addc32 w5 r11 c  -- adcs.w r5, r5, r11
  let w5 := adcs_pair.1             --   `-> r5
  let c := adcs_pair.2              --   `-> carry
  let adcs_pair := addc32 w6 r11 c  -- adcs.w r8, r8, r11
  let w6 := adcs_pair.1             --   `-> r8
  let c := adcs_pair.2              --   `-> carry
  let r11 := andw r12 0x40000000    -- and.w r11, r12, #0x40000000
  let w7 := (addc32 w7 r11 c).1     -- adc.w r9, r9, r11
  ⟨w0, w1, w2, w3, w4, w5, w6, w7, w8⟩

/-- The checked 31-instruction suffix of `from_mont`, composed from mechanically accounted
subtraction-mask and masked-add-back helpers. Its ninth accumulator word is unchanged. -/
def fromMontFinalReductionBlock (modulus : Limbs) (st : FromMontState) : FromMontState :=
  let subtraction := fromMontFinalSubtractionBlock modulus st  -- mechanically factored PCs 0 through 13
  let addback := fromMontFinalAddBackBlock modulus subtraction  -- mechanically factored PCs 14 through 30
  addback

/-- The fixed-register inline `asm!` block of `from_mont`: load eight input words, apply eight
mechanically checked rotated Montgomery rounds, then call the checked final reduction block once. -/
def fromMontBlock (value modulus : Limbs) : Limbs :=
  let r0_0 := value.l0 % wordMod    -- input r0[0]
  let r0_4 := value.l0 / wordMod    -- input r0[4]
  let r0_8 := value.l1 % wordMod    -- input r0[8]
  let r0_12 := value.l1 / wordMod   -- input r0[12]
  let r0_16 := value.l2 % wordMod   -- input r0[16]
  let r0_20 := value.l2 / wordMod   -- input r0[20]
  let r0_24 := value.l3 % wordMod   -- input r0[24]
  let r0_28 := value.l3 / wordMod   -- input r0[28]
  -- input r1[0]: r1_0 = modulus.l0 % wordMod is never read
  -- input r1[4]: r1_4 = modulus.l0 / wordMod is never read
  -- input r1[8]: r1_8 = modulus.l1 % wordMod is never read
  -- input r1[12]: r1_12 = modulus.l1 / wordMod is never read
  -- input r1[16]: r1_16 = modulus.l2 % wordMod is never read
  -- input r1[20]: r1_20 = modulus.l2 / wordMod is never read
  -- input r1[24]: r1_24 = modulus.l3 % wordMod is never read
  -- input r1[28]: r1_28 = modulus.l3 / wordMod is never read
  let r2 := r0_0                    -- ldr.w r2, [r0, #0]
  let r3 := r0_4                    -- ldr.w r3, [r0, #4]
  let r4 := r0_8                    -- ldr.w r4, [r0, #8]
  let r5 := r0_12                   -- ldr.w r5, [r0, #12]
  let r8 := r0_16                   -- ldr.w r8, [r0, #16]
  let r9 := r0_20                   -- ldr.w r9, [r0, #20]
  let r10 := r0_24                  -- ldr.w r10, [r0, #24]
  let r11 := r0_28                  -- ldr.w r11, [r0, #28]
  let r14 := 0                      -- mov.w lr, #0
  let round1 := fromMontRound modulus ⟨r2, r3, r4, r5, r8, r9, r10, r11, r14⟩  -- from_mont_round!, invocation 1
