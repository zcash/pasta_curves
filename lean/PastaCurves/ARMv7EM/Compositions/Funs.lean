def asm.armv7em.divstep59
  (two_delta : Std.U64) (f0 : Std.U64) (g0 : Std.U64) :
  Result (Array Std.U64 5#usize)
  := do
  let a ← asm.armv7em.batch 20#u32 two_delta f0 g0
  let d1 ← Array.index_usize a 0#usize
  let u1 ← Array.index_usize a 1#usize
  let v1 ← Array.index_usize a 2#usize
  let q1 ← Array.index_usize a 3#usize
  let r1 ← Array.index_usize a 4#usize
  let f1 ← inversion.portable.next_low 20#u32 u1 v1 f0 g0
  let g1 ← inversion.portable.next_low 20#u32 q1 r1 f0 g0
  let a1 ← asm.armv7em.batch 20#u32 d1 f1 g1
  let d2 ← Array.index_usize a1 0#usize
  let u2 ← Array.index_usize a1 1#usize
  let v2 ← Array.index_usize a1 2#usize
  let q2 ← Array.index_usize a1 3#usize
  let r2 ← Array.index_usize a1 4#usize
  let f2 ← inversion.portable.next_low 20#u32 u2 v2 f1 g1
  let g2 ← inversion.portable.next_low 20#u32 q2 r2 f1 g1
  let a2 ← asm.armv7em.batch 19#u32 d2 f2 g2
  let d3 ← Array.index_usize a2 0#usize
  let u3 ← Array.index_usize a2 1#usize
  let v3 ← Array.index_usize a2 2#usize
  let q3 ← Array.index_usize a2 3#usize
  let r3 ← Array.index_usize a2 4#usize
  let a3 ←
    inversion.portable.mat_mul (Array.make 4#usize [ u2, v2, q2, r2 ])
      (Array.make 4#usize [ u1, v1, q1, r1 ])
  let matrix ←
    inversion.portable.mat_mul (Array.make 4#usize [ u3, v3, q3, r3 ]) a3
