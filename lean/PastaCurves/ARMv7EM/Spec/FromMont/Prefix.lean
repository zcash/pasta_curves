import PastaCurves.ARMv7EM.Spec.FromMont.Round

/-!
# The exact prefix of one ARMv7E-M Montgomery conversion round

The three source instructions are mechanically accounted for by three one-instruction generated
traces. Their generated binding-IR fingerprints must concatenate to the exact source prefix before
the record-valued `fromMontRoundPrefix` composes them. Each instruction skeleton is generated by
`lean/scripts/gen.py`; only theorem statements and marked conclusions are handwritten.
-/

namespace PastaCurves.ARMv7EM

-- BEGIN fromMontRoundPrefixQuotient_spec statement
/-- The first source instruction computes the Montgomery quotient and its zero-test carry. -/
theorem fromMontRoundPrefixQuotient_spec (st : FromMontState) (hst : st.Bounded) :
    ∀ res, res = fromMontRoundPrefixQuotient st.w0 →
      res.1 = fromMontQuotient st ∧ res.2 = (if st.w0 = 0 then 1 else 0) := by
  let w0 := st.w0
  have hw0 : w0 < wordMod := hst.1
  change ∀ res, res = fromMontRoundPrefixQuotient w0 → _
  intro res hres
-- END fromMontRoundPrefixQuotient_spec statement
  -- generated skeleton for `fromMontRoundPrefixQuotient`: do not edit between the annotations
  unfold fromMontRoundPrefixQuotient at hres
  -- w0': low accumulator word
  word_step -clear w0' := w0
  have b_w0' : w0' < 2^32 := by rw [e_w0']; exact hw0
  -- w0_1: rsbs.w r2, r2, #0
  word_step -clear d, w0_1 := (0 + 2^32 - w0' - (1 - 1)) % 2^32,
      c := (0 + 2^32 - w0' - (1 - 1)) / 2^32
  have b_w0_1 : w0_1 < 2^32 := by rw [e_w0_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have l_w0_1 : w0_1 + 2^32 * c + w0' + 1 = 0 + 2^32 + 1 := by
    rw [e_w0_1, e_c]; exact subc32_lin 0 w0' 1 b_w0' (by decide)
  have b_c : c ≤ 1 := by
    rw [e_c]; exact subc32_carry_le_one 0 w0' 1 (by decide)
  -- BEGIN retain quotient equations
  have h_w0_1 := e_w0_1
  have h_c := e_c
  -- END retain quotient equations
  clear e_w0_1 e_c
  subst hres
  -- BEGIN fromMontRoundPrefixQuotient_spec conclusion
  have hfirst := subc32_zero_sub_one st.w0 hst.1
  have hprefix := fromMontRound_quotient_prefix st hst
  dsimp only at hprefix
  constructor
  · simpa only [Prod.fst, subc32, wordMod, w0, e_w0', h_w0_1] using hprefix.2.1
  · simpa only [Prod.snd, subc32, wordMod, w0, e_w0', h_c] using
      congrArg Prod.snd hfirst
  -- END fromMontRoundPrefixQuotient_spec conclusion

-- BEGIN fromMontRoundPrefixSelfSub_spec statement
/-- The second source instruction self-subtracts the quotient under the first carry. -/
theorem fromMontRoundPrefixSelfSub_spec (quotient subCarry : Nat)
    (hquotient : quotient < wordMod) (hsubCarry : subCarry < wordMod) :
    ∀ res, res = fromMontRoundPrefixSelfSub quotient subCarry →
      res = (subc32 quotient quotient subCarry).1 := by
  intro res hres
-- END fromMontRoundPrefixSelfSub_spec statement
  -- generated skeleton for `fromMontRoundPrefixSelfSub`: do not edit between the annotations
  unfold fromMontRoundPrefixSelfSub at hres
  -- w0: Montgomery quotient
  word_step -clear w0 := quotient
  have b_w0 : w0 < 2^32 := by rw [e_w0]; exact hquotient
  -- c: subtraction carry
  word_step -clear c := subCarry
  have b_c : c < 2^32 := by rw [e_c]; exact hsubCarry
  -- r12: sbc.w r12, r2, r2
  word_step -clear r12 := (w0 + 2^32 - w0 - (1 - c)) % 2^32
  have b_r12 : r12 < 2^32 := by rw [e_r12]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  subst hres
  -- BEGIN fromMontRoundPrefixSelfSub_spec conclusion
  simp only [subc32, wordMod, e_r12, e_w0, e_c]
  -- END fromMontRoundPrefixSelfSub_spec conclusion

-- BEGIN fromMontRoundPrefixMask_spec statement
/-- The third source instruction masks the self-subtraction result to its low bit. -/
theorem fromMontRoundPrefixMask_spec (selfSub : Nat) (hselfSub : selfSub < wordMod) :
    ∀ res, res = fromMontRoundPrefixMask selfSub → res = andw selfSub 1 := by
  intro res hres
-- END fromMontRoundPrefixMask_spec statement
  -- generated skeleton for `fromMontRoundPrefixMask`: do not edit between the annotations
  unfold fromMontRoundPrefixMask at hres
  -- r12: self-subtraction result
  word_step -clear r12 := selfSub
  have b_r12 : r12 < 2^32 := by rw [e_r12]; exact hselfSub
  -- r12_1: and.w r12, r12, #1
  word_step -clear r12_1 := andw r12 1
  have b_r12_1 : r12_1 < 2^32 := by
    rw [e_r12_1]; exact Nat.and_lt_two_pow r12 (by decide)
  subst hres
  -- BEGIN fromMontRoundPrefixMask_spec conclusion
  simp only [e_r12_1, e_r12]
  -- END fromMontRoundPrefixMask_spec conclusion

-- BEGIN fromMontRoundPrefix_spec statement
/-- The checked three-instruction prefix returns the quotient and low-word cancellation carry. -/
theorem fromMontRoundPrefix_spec (st : FromMontState) (hst : st.Bounded) :
    ∀ res, res = fromMontRoundPrefix st.w0 →
      res.quotient = fromMontQuotient st ∧
        res.carry = (adc st.w0 (fromMontQuotient st) 0).2 := by
  let w0 := st.w0
  change ∀ res, res = fromMontRoundPrefix w0 → _
  intro res hres
-- END fromMontRoundPrefix_spec statement
  -- generated skeleton for `fromMontRoundPrefix`: do not edit between the annotations
  unfold fromMontRoundPrefix at hres
  -- quotientResult: mechanically factored PC 0
  word_step quotientResult := fromMontRoundPrefixQuotient w0
  -- quotient: quotient helper output
  word_step quotient := quotientResult.1
  -- subCarry: quotient helper output
  word_step subCarry := quotientResult.2
  -- selfSub: mechanically factored PC 1
  word_step selfSub := fromMontRoundPrefixSelfSub quotient subCarry
  -- carry: mechanically factored PC 2
  word_step carry := fromMontRoundPrefixMask selfSub
  subst hres
  -- BEGIN fromMontRoundPrefix_spec conclusion
  have hquotient := fromMontRoundPrefixQuotient_spec st hst quotientResult e_quotientResult
  have hquotientBound : quotient < wordMod := by
    rw [e_quotient, hquotient.1]
    exact (fromMontQuotient_spec st hst).1
  have hsubCarryBit : subCarry ≤ 1 := by
    rw [e_subCarry, hquotient.2]
    split <;> decide
  have hsubCarryBound : subCarry < wordMod :=
    lt_of_le_of_lt hsubCarryBit (by norm_num [wordMod])
  have hselfSub := fromMontRoundPrefixSelfSub_spec quotient subCarry hquotientBound
    hsubCarryBound selfSub e_selfSub
  have hselfSubBound : selfSub < wordMod := by
    rw [hselfSub]
    exact Nat.mod_lt _ (by norm_num [wordMod])
  have hmask := fromMontRoundPrefixMask_spec selfSub hselfSubBound carry e_carry
  constructor
  · rw [e_quotient, hquotient.1]
  · rw [hmask, hselfSub]
    have hmasked := subc32_self_and_one quotient subCarry hsubCarryBit
    rw [hmasked, e_subCarry, hquotient.2, adc_fromMontQuotient_carry st hst]
    split <;> simp_all
  -- END fromMontRoundPrefix_spec conclusion

end PastaCurves.ARMv7EM
