-- BEGIN condSub_spec field corollary
/-- At either Pasta field, `condSub` meets the conditional-subtraction contract consumed by the
inversion composition. -/
theorem condSub_pasta_spec (F : PastaField) (value : Limbs) (hv : value.Bounded) :
    (condSub value F.modulus).Bounded ∧
      ((value.toNat < F.modulus.toNat ∧ (condSub value F.modulus).toNat = value.toNat) ∨
        (F.modulus.toNat ≤ value.toNat ∧
          (condSub value F.modulus).toNat + F.modulus.toNat = value.toNat)) :=
  condSub_spec value F.modulus hv F.bounded _ rfl
-- END condSub_spec field corollary

