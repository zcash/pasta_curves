import PastaCurves.ARMv7EM.Spec.Arithmetic
import PastaCurves.ARMv7EM.Spec.Invert.Divstep59.PackedAdapter

/-!
# Exact final instructions of an ARMv7E-M batch round

The instruction trace is generated by `lean/scripts/gen.py`; only the theorem statement, helper
lemmas, and marked conclusion block are handwritten. The theorem proves both halves of the signed
cross-word shift together with every public loop-control output.
-/

namespace PastaCurves.ARMv7EM

-- BEGIN shift helpers
/-- The low word produced by the final cross-word shift is the logical shift of the joined words. -/
private theorem join32_lsr_one (low high : Nat) (hlow : low < wordMod) (_hhigh : high < wordMod) :
    join32 (orr32 (low / 2^1) (lsl32 high 31)) (high / 2^1) = join32 low high / 2 := by
  have hlowHalf : low / 2 < 2^31 := by
    norm_num [wordMod] at hlow ⊢
    omega
  have hhighSplit := Nat.mod_add_div high 2
  have hlowSplit := Nat.mod_add_div low 2
  have hshift : high * 2^31 % 2^32 = high % 2 * 2^31 := by
    rw [show (2 : Nat)^32 = 2 * 2^31 by norm_num, Nat.mul_mod_mul_right]
  have hor : (low / 2 ||| high % 2 * 2^31) = low / 2 + high % 2 * 2^31 := by
    calc
      low / 2 ||| high % 2 * 2^31 = high % 2 * 2^31 ||| low / 2 := Nat.or_comm _ _
      _ = high % 2 * 2^31 + low / 2 := by
        simpa [Nat.shiftLeft_eq] using
          (Nat.shiftLeft_add_eq_or_of_lt hlowHalf (high % 2)).symm
      _ = low / 2 + high % 2 * 2^31 := Nat.add_comm _ _
  norm_num [join32, orr32, lsl32, wordMod] at hshift hor ⊢
  rw [hshift, hor, Nat.mod_eq_of_lt]
  · omega
  · have hmod : high % 2 < 2 := Nat.mod_lt _ (by decide)
    omega

/-- The paired 32-bit instructions implement one signed right shift of the joined 64-bit word. -/
private theorem join32_asr_one (low high : Nat) (hlow : low < wordMod)
    (hhigh : high < wordMod) :
    join32 (orr32 (low / 2^1) (lsl32 high 31)) (asr32 high 1) =
      asr (join32 low high) 1 := by
  have hlogical := join32_lsr_one low high hlow hhigh
  have hsign : join32 low high < 2^63 ↔ high < 2^31 := by
    norm_num [join32, wordMod] at hlow hhigh ⊢
    omega
  unfold asr32 asr
  by_cases hhighSign : high < 2^31
  · rw [if_pos hhighSign, if_pos (hsign.mpr hhighSign)]
    exact hlogical
  · rw [if_neg hhighSign, if_neg (not_congr hsign |>.mpr hhighSign)]
    norm_num [join32, wordMod] at hlogical ⊢
    omega
-- END shift helpers

-- BEGIN batchRoundFinish_spec statement
/-- The factored finish shifts the complete packed word right arithmetically and exactly computes
its decrement, carry, zero flag, and backward-branch decision. -/
theorem batchRoundFinish_spec (pglo pghi remaining : Nat) (hpglo : pglo < wordMod)
    (hpghi : pghi < wordMod) (hremaining : remaining < wordMod)
    (hpositive : 1 ≤ remaining) (hcount : remaining ≤ 20) :
    ∀ res, res = batchRoundFinish pglo pghi remaining →
      res.pglo < wordMod ∧ res.pghi < wordMod ∧
        join32 res.pglo res.pghi = asr (join32 pglo pghi) 1 ∧
        res.remaining = remaining - 1 ∧ res.c = 1 ∧
        res.z = (if remaining = 1 then 1 else 0) ∧
        res.branch = (if remaining = 1 then 0 else 1) := by
  intro res hres
-- END batchRoundFinish_spec statement
  -- generated skeleton for `batchRoundFinish`: do not edit between the annotations
  unfold batchRoundFinish at hres
  lift_lets -merge at hres
  -- pglo': input pglo
  word_step -clear pglo' := pglo
  have b_pglo' : pglo' < 2^32 := by rw [e_pglo']; exact hpglo
  -- pghi': input pghi
  word_step -clear pghi' := pghi
  have b_pghi' : pghi' < 2^32 := by rw [e_pghi']; exact hpghi
  -- remaining': input remaining
  word_step -clear remaining' := remaining
  have b_remaining' : remaining' < 2^32 := by rw [e_remaining']; exact hremaining
  -- tmp: lsr.w {tmp}, {pglo}, #1
  word_step -clear tmp := pglo' / 2^1
  have b_tmp : tmp < 2^32 := by
    rw [e_tmp]; exact lt_of_le_of_lt (Nat.div_le_self _ _) b_pglo'
  -- pglo_1: orr.w {pglo}, {tmp}, {pghi}, lsl #31
  word_step -clear pglo_1 := orr32 tmp (lsl32 pghi' 31)
  have b_pglo_1 : pglo_1 < 2^32 := by rw [e_pglo_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  -- pghi_1: asr.w {pghi}, {pghi}, #1
  word_step -clear pghi_1 := asr32 pghi' 1
  have b_pghi_1 : pghi_1 < 2^32 := by
    rw [e_pghi_1]; exact asr32_one_lt pghi' b_pghi'
  -- sub: subs {remaining}, {remaining}, #1
  word_step -clear sub, remaining_1 := (remaining' + 2^32 - 1 - (1 - 1)) % 2^32,
      c := (remaining' + 2^32 - 1 - (1 - 1)) / 2^32, z
  have b_remaining_1 : remaining_1 < 2^32 := by rw [e_remaining_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have l_remaining_1 : remaining_1 + 2^32 * c + 1 + 1 = remaining' + 2^32 + 1 := by
    rw [e_remaining_1, e_c]; exact subc32_lin remaining' 1 1 (by decide) (by decide)
  have b_c : c ≤ 1 := by
    rw [e_c]; exact subc32_carry_le_one remaining' 1 1 b_remaining'
  clear e_remaining_1 e_c
  -- BEGIN residual tail rebind
  have hresNew :
      (let z := if remaining_1 = 0 then 1 else 0
       let branch := if z = 0 then 1 else 0
       res = ⟨pglo_1, pghi_1, remaining_1, c, z, branch⟩) := hres
  clear hres
  clear_value pglo' pghi' remaining' tmp pglo_1 pghi_1 sub remaining_1 c
  have hres := hresNew
  clear hresNew
  -- END residual tail rebind
  -- z: None
  word_step -clear z := (if remaining_1 = 0 then 1 else 0)
  have b_z : z ≤ 1 := by rw [e_z]; split <;> decide
  -- branch: bne 2b
  word_step -clear branch := (if z = 0 then 1 else 0)
  have b_branch : branch ≤ 1 := by rw [e_branch]; split <;> decide
  subst hres
  -- BEGIN batchRoundFinish_spec conclusion
  have hshift : join32 pglo_1 pghi_1 = asr (join32 pglo pghi) 1 := by
    rw [e_pglo_1, e_tmp, e_pghi_1, e_pglo', e_pghi']
    exact join32_asr_one pglo pghi hpglo hpghi
  have hcontrol : remaining_1 = remaining - 1 ∧ c = 1 := by
    rw [e_remaining'] at l_remaining_1
    omega
  have hz : z = if remaining = 1 then 1 else 0 := by
    rw [e_z, hcontrol.1]
    split <;> split <;> omega
  have hbranch : branch = if remaining = 1 then 0 else 1 := by
    rw [e_branch, hz]
    split <;> simp_all
  exact ⟨b_pglo_1, b_pghi_1, hshift, hcontrol.1, hcontrol.2, hz, hbranch⟩
  -- END batchRoundFinish_spec conclusion

end PastaCurves.ARMv7EM
