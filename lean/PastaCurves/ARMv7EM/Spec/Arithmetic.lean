import PastaCurves.Spec
import PastaCurves.ARMv7EM.Transcription
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

/-!
# Correctness of the ARMv7E-M word primitives

The four theorems in this module prove the register-only Thumb-2 primitives over arbitrary
32-bit words. Carry and borrow inputs are additionally required to be bits where the Rust callers
use them as such. Their instruction traces are generated by `lean/scripts/gen.py`; only theorem
statements and the marked annotation blocks are handwritten.
-/

namespace PastaCurves.ARMv7EM

-- BEGIN instruction lemmas
/-- The carry out of an addition of two 32-bit words and a carry bit is a bit. -/
theorem addc32_carry_le_one (a b carry : Nat) (ha : a < 2^32) (hb : b < 2^32)
    (hcarry : carry ≤ 1) : (a + b + carry) / 2^32 ≤ 1 := by
  omega

/-- A 32-bit subtraction result and its no-borrow carry reconstruct the input subtraction. -/
theorem subc32_lin (a b carry : Nat) (hb : b < 2^32) (hcarry : carry ≤ 1) :
    (a + 2^32 - b - (1 - carry)) % 2^32 +
          2^32 * ((a + 2^32 - b - (1 - carry)) / 2^32) + b + 1 =
      a + 2^32 + carry := by
  omega

/-- The no-borrow carry out of a 32-bit subtraction is a bit. -/
theorem subc32_carry_le_one (a b carry : Nat) (ha : a < 2^32) :
    (a + 2^32 - b - (1 - carry)) / 2^32 ≤ 1 := by
  omega
-- END instruction lemmas

-- BEGIN adc_spec statement
/-- `adc` returns the low 32-bit word and carry bit of the exact sum. -/
theorem adc_spec (a b carry : Nat) (ha : a < 2^32) (hb : b < 2^32)
    (hcarry : carry < 2^32) (hcarry_bit : carry ≤ 1) :
    ∀ res, res = adc a b carry →
      res.1 + 2^32 * res.2 = a + b + carry ∧ res.1 < 2^32 ∧ res.2 ≤ 1 := by
  intro res hres
-- END adc_spec statement
  -- generated skeleton for `adc`: do not edit between the annotations
  unfold adc at hres
  lift_lets -merge at hres
  -- a': input a
  word_step a' := a
  have b_a' : a' < 2^32 := by rw [e_a']; exact ha
  -- b': input b
  word_step b' := b
  have b_b' : b' < 2^32 := by rw [e_b']; exact hb
  -- carry': input carry
  word_step carry' := carry
  have b_carry' : carry' < 2^32 := by rw [e_carry']; exact hcarry
  -- sum: adds {sum}, {a}, {b}
  word_step s, sum := (a' + b' + 0) % 2^32, c := (a' + b' + 0) / 2^32
  have b_sum : sum < 2^32 := by rw [e_sum]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have l_sum : sum + 2^32 * c = a' + b' + 0 := by
    rw [e_sum, e_c]; exact Nat.mod_add_div _ _
  have b_c : c ≤ 1 := by
    rw [e_c]; exact addc32_carry_le_one a' b' 0 b_a' b_b' (by decide)
  clear e_sum e_c
  -- carry_out: mov {carry_out}, #0
  word_step carry_out := 0
  have b_carry_out : carry_out < 2^32 := by rw [e_carry_out]; exact (by decide)
  -- carry_out_1: adc {carry_out}, {carry_out}, #0
  word_step carry_out_1 := (carry_out + 0 + c) % 2^32
  have b_carry_out_1 : carry_out_1 < 2^32 := by rw [e_carry_out_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  obtain ⟨k_carry_out_1, b_k_carry_out_1, l_carry_out_1⟩ :
      ∃ k, k ≤ 1 ∧ carry_out_1 + 2^32 * k = carry_out + 0 + c :=
    ⟨(carry_out + 0 + c) / 2^32, addc32_carry_le_one carry_out 0 c b_carry_out (by decide) b_c,
      by rw [e_carry_out_1]; exact Nat.mod_add_div _ _⟩
  clear e_carry_out_1
  -- sum_1: adds {sum}, {sum}, {carry}
  word_step s_1, sum_1 := (sum + carry' + 0) % 2^32, c_1 := (sum + carry' + 0) / 2^32
  have b_sum_1 : sum_1 < 2^32 := by rw [e_sum_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have l_sum_1 : sum_1 + 2^32 * c_1 = sum + carry' + 0 := by
    rw [e_sum_1, e_c_1]; exact Nat.mod_add_div _ _
  have b_c_1 : c_1 ≤ 1 := by
    rw [e_c_1]; exact addc32_carry_le_one sum carry' 0 b_sum b_carry' (by decide)
  clear e_sum_1 e_c_1
  -- carry_out_2: adc {carry_out}, {carry_out}, #0
  word_step carry_out_2 := (carry_out_1 + 0 + c_1) % 2^32
  have b_carry_out_2 : carry_out_2 < 2^32 := by rw [e_carry_out_2]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  obtain ⟨k_carry_out_2, b_k_carry_out_2, l_carry_out_2⟩ :
      ∃ k, k ≤ 1 ∧ carry_out_2 + 2^32 * k = carry_out_1 + 0 + c_1 :=
    ⟨(carry_out_1 + 0 + c_1) / 2^32, addc32_carry_le_one carry_out_1 0 c_1 b_carry_out_1 (by decide) b_c_1,
      by rw [e_carry_out_2]; exact Nat.mod_add_div _ _⟩
  clear e_carry_out_2
  subst hres
  -- BEGIN adc_spec conclusion
  have hcarry' : carry' ≤ 1 := by rw [e_carry']; exact hcarry_bit
  have hfirst : carry_out_1 = c := by
    clear * - e_carry_out l_carry_out_1 b_c b_carry_out_1 b_k_carry_out_1
    omega
  have hfinal : carry_out_2 = carry_out_1 + c_1 := by
    clear * - l_carry_out_2 hfirst b_c b_c_1 b_carry_out_2 b_k_carry_out_2
    omega
  have hout : sum_1 + 2^32 * carry_out_2 = a' + b' + carry' := by
    clear * - l_sum l_sum_1 hfirst hfinal
    omega
  refine ⟨?_, b_sum_1, ?_⟩
  · simpa only [e_a', e_b', e_carry'] using hout
  · have hsum : a' + b' + carry' < 2^33 := by omega
    clear * - hout hsum
    omega
  -- END adc_spec conclusion

-- BEGIN addWord_spec statement
/-- `addWord` returns the low 32-bit word and carry bit of the exact sum. -/
theorem addWord_spec (a b : Nat) (ha : a < 2^32) (hb : b < 2^32) :
    ∀ res, res = addWord a b →
      res.1 + 2^32 * res.2 = a + b ∧ res.1 < 2^32 ∧ res.2 ≤ 1 := by
  intro res hres
-- END addWord_spec statement
  -- generated skeleton for `addWord`: do not edit between the annotations
  unfold addWord at hres
  lift_lets -merge at hres
  -- a': input a
  word_step a' := a
  have b_a' : a' < 2^32 := by rw [e_a']; exact ha
  -- b': input b
  word_step b' := b
  have b_b' : b' < 2^32 := by rw [e_b']; exact hb
  -- sum: adds {sum}, {a}, {b}
  word_step s, sum := (a' + b' + 0) % 2^32, c := (a' + b' + 0) / 2^32
  have b_sum : sum < 2^32 := by rw [e_sum]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have l_sum : sum + 2^32 * c = a' + b' + 0 := by
    rw [e_sum, e_c]; exact Nat.mod_add_div _ _
  have b_c : c ≤ 1 := by
    rw [e_c]; exact addc32_carry_le_one a' b' 0 b_a' b_b' (by decide)
  clear e_sum e_c
  -- carry: mov {carry}, #0
  word_step carry := 0
  have b_carry : carry < 2^32 := by rw [e_carry]; exact (by decide)
  -- carry_1: adc {carry}, {carry}, #0
  word_step carry_1 := (carry + 0 + c) % 2^32
  have b_carry_1 : carry_1 < 2^32 := by rw [e_carry_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  obtain ⟨k_carry_1, b_k_carry_1, l_carry_1⟩ :
      ∃ k, k ≤ 1 ∧ carry_1 + 2^32 * k = carry + 0 + c :=
    ⟨(carry + 0 + c) / 2^32, addc32_carry_le_one carry 0 c b_carry (by decide) b_c,
      by rw [e_carry_1]; exact Nat.mod_add_div _ _⟩
  clear e_carry_1
  subst hres
  -- BEGIN addWord_spec conclusion
  have hcarry : carry_1 = c := by
    clear * - e_carry l_carry_1 b_c b_carry_1 b_k_carry_1
    omega
  refine ⟨?_, b_sum, ?_⟩
  · simpa only [e_a', e_b', hcarry, Nat.add_zero] using l_sum
  · simpa only [hcarry] using b_c
  -- END addWord_spec conclusion

-- BEGIN sbb_spec statement
/-- `sbb` returns the low 32-bit difference and a borrow bit for the exact subtraction. -/
theorem sbb_spec (a b borrow : Nat) (ha : a < 2^32) (hb : b < 2^32)
    (hborrow : borrow < 2^32) (hborrow_bit : borrow ≤ 1) :
    ∀ res, res = sbb a b borrow →
      res.1 + b + borrow = a + 2^32 * res.2 ∧ res.1 < 2^32 ∧ res.2 ≤ 1 := by
  intro res hres
-- END sbb_spec statement
  -- generated skeleton for `sbb`: do not edit between the annotations
  unfold sbb at hres
  lift_lets -merge at hres
  -- a': input a
  word_step a' := a
  have b_a' : a' < 2^32 := by rw [e_a']; exact ha
  -- b': input b
  word_step b' := b
  have b_b' : b' < 2^32 := by rw [e_b']; exact hb
  -- borrow': input borrow
  word_step borrow' := borrow
  have b_borrow' : borrow' < 2^32 := by rw [e_borrow']; exact hborrow
  -- d: rsbs {borrow}, {borrow}, #0
  word_step d, c := (0 + 2^32 - borrow' - (1 - 1)) / 2^32
  have b_c : c ≤ 1 := by
    rw [e_c]; exact subc32_carry_le_one 0 borrow' 1 (by decide)
  -- BEGIN sbb_spec borrow conversion
  have hborrow' : borrow' ≤ 1 := by rw [e_borrow']; exact hborrow_bit
  have l_c : c + borrow' = 1 := by
    obtain hzero | hone : borrow' = 0 ∨ borrow' = 1 := by omega
    · norm_num [hzero] at e_c
      omega
    · norm_num [hone] at e_c
      omega
  -- END sbb_spec borrow conversion
  clear e_c
  -- difference: sbcs {difference}, {a}, {b}
  word_step d_1, difference := (a' + 2^32 - b' - (1 - c)) % 2^32,
      c_1 := (a' + 2^32 - b' - (1 - c)) / 2^32
  have b_difference : difference < 2^32 := by rw [e_difference]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have l_difference : difference + 2^32 * c_1 + b' + 1 = a' + 2^32 + c := by
    rw [e_difference, e_c_1]; exact subc32_lin a' b' c b_b' b_c
  have b_c_1 : c_1 ≤ 1 := by
    rw [e_c_1]; exact subc32_carry_le_one a' b' c b_a'
  clear e_difference e_c_1
  -- borrow_out: mov {borrow_out}, #0
  word_step borrow_out := 0
  have b_borrow_out : borrow_out < 2^32 := by rw [e_borrow_out]; exact (by decide)
  -- borrow_out_1: adc {borrow_out}, {borrow_out}, #0
  word_step borrow_out_1 := (borrow_out + 0 + c_1) % 2^32
  have b_borrow_out_1 : borrow_out_1 < 2^32 := by rw [e_borrow_out_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  obtain ⟨k_borrow_out_1, b_k_borrow_out_1, l_borrow_out_1⟩ :
      ∃ k, k ≤ 1 ∧ borrow_out_1 + 2^32 * k = borrow_out + 0 + c_1 :=
    ⟨(borrow_out + 0 + c_1) / 2^32, addc32_carry_le_one borrow_out 0 c_1 b_borrow_out (by decide) b_c_1,
      by rw [e_borrow_out_1]; exact Nat.mod_add_div _ _⟩
  clear e_borrow_out_1
  -- borrow_out_2: eor {borrow_out}, {borrow_out}, #1
  word_step borrow_out_2 := (borrow_out_1 ^^^ 1) % 2^32
  have b_borrow_out_2 : borrow_out_2 < 2^32 := by rw [e_borrow_out_2]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have w_borrow_out_2 : (borrow_out_1 ^^^ 1) < 2^32 := Nat.xor_lt_two_pow b_borrow_out_1 (by decide)
  subst hres
  -- BEGIN sbb_spec conclusion
  have hcarry_out : borrow_out_1 = c_1 := by
    clear * - e_borrow_out l_borrow_out_1 b_c_1 b_borrow_out_1 b_k_borrow_out_1
    omega
  have hborrow_out : borrow_out_2 + c_1 = 1 := by
    obtain hzero | hone : c_1 = 0 ∨ c_1 = 1 := by omega
    · norm_num [hcarry_out, hzero] at e_borrow_out_2
      omega
    · norm_num [hcarry_out, hone] at e_borrow_out_2
      omega
  have hout : difference + b' + borrow' = a' + 2^32 * borrow_out_2 := by
    clear * - l_difference l_c hborrow_out
    omega
  refine ⟨?_, b_difference, ?_⟩
  · simpa only [e_a', e_b', e_borrow'] using hout
  · clear * - hborrow_out
    omega
  -- END sbb_spec conclusion

-- BEGIN macWord_spec statement
/-- `macWord` returns the low and high 32-bit words of the exact multiply-accumulate. -/
theorem macWord_spec (acc a b carry : Nat) (hacc : acc < 2^32) (ha : a < 2^32)
    (hb : b < 2^32) (hcarry : carry < 2^32) :
    ∀ res, res = macWord acc a b carry →
      res.1 + 2^32 * res.2 = a * b + acc + carry ∧ res.1 < 2^32 ∧ res.2 < 2^32 := by
  intro res hres
-- END macWord_spec statement
  -- generated skeleton for `macWord`: do not edit between the annotations
  unfold macWord at hres
  lift_lets -merge at hres
  -- low: input low
  word_step low := acc
  have b_low : low < 2^32 := by rw [e_low]; exact hacc
  -- high: input high
  word_step high := carry
  have b_high : high < 2^32 := by rw [e_high]; exact hcarry
  -- a': input a
  word_step a' := a
  have b_a' : a' < 2^32 := by rw [e_a']; exact ha
  -- b': input b
  word_step b' := b
  have b_b' : b' < 2^32 := by rw [e_b']; exact hb
  -- low_1: umaal {low}, {high}, {a}, {b}
  word_step m, low_1 := (a' * b' + low + high) % 2^32, high_1 := (a' * b' + low + high) / 2^32
  have b_low_1 : low_1 < 2^32 := by rw [e_low_1]; exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have m_high_1 : a' * b' ≤ (2^32 - 1) * (2^32 - 1) := Nat.mul_le_mul (Nat.le_sub_one_of_lt b_a') (Nat.le_sub_one_of_lt b_b')
  have t_high_1 : (a' * b' + low + high) < 2^64 := by omega
  have b_high_1 : high_1 < 2^32 := by
    rw [e_high_1]; exact Nat.div_lt_of_lt_mul (lt_of_lt_of_eq t_high_1 (by norm_num))
  have d_high_1 : low_1 + 2^32 * high_1 = (a' * b' + low + high) := by
    rw [e_low_1, e_high_1]; exact Nat.mod_add_div _ _
  clear e_low_1 e_high_1
  subst hres
  -- BEGIN macWord_spec conclusion
  refine ⟨?_, b_low_1, b_high_1⟩
  simpa only [e_a', e_b', e_low, e_high] using d_high_1
  -- END macWord_spec conclusion

end PastaCurves.ARMv7EM
